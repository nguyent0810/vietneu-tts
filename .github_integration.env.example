# Copy file này thành .github_integration.env rồi điền giá trị thật.
# .github_integration.env đã nằm trong .gitignore — KHÔNG commit lên git,
# KHÔNG dán token vào chat/nơi khác ngoài file này.
#
# Token nên tạo dạng "Fine-grained personal access token" tại
# https://github.com/settings/personal-access-tokens/new, chỉ cấp quyền
# "Contents: Read-only" (hoặc Read/Write nếu cần mình chỉnh sửa code) cho
# ĐÚNG các repo liệt kê bên dưới, có ngày hết hạn — không dùng token full quyền.

GITHUB_TOKEN=

# Repo cần tích hợp — thêm dòng mới khi có thêm repo (không cần sửa code,
# đây chỉ là danh sách tham chiếu).
CONTENT_TOOL_REPO=https://github.com/<user>/<content-tool-repo>
VIDEO_TOOL_REPO=https://github.com/<user>/<video-tool-repo>
