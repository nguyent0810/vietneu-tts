   564	function allMatches(re: RegExp, text: string): RegExpExecArray[] {
   565	  const g = new RegExp(re.source, re.flags.includes('g') ? re.flags : `${re.flags}g`)
   566	  const out: RegExpExecArray[] = []
   567	  let m: RegExpExecArray | null
   568	  while ((m = g.exec(text)) !== null) {
