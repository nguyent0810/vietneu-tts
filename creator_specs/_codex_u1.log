   252	 *  - một mảnh (không phải mảnh đầu) MỞ ĐẦU bằng liên từ liệt kê
   253	 *    -> "thumbnail, tiêu đề, hay packaging";
   254	 *  - một mảnh (không phải mảnh đầu) CHỨA liên từ liệt kê mà KHÔNG mang dấu hiệu
   255	 *    phán xét nào -> "tiếp cận, CTR, thumbnail và packaging" (tiếng Việt thường
   256	 *    bỏ dấu phẩy trước "và" ở mục cuối, nên liên từ nằm GIỮA mảnh cuối).
   257	 *
   258	 * Điều kiện "không mang phán xét" là hàng rào giữ cho phép gộp không nuốt một ca
   259	 * hai phát biểu thật: "CTR thấp, impressions và thumbnail đều cao" có "cao" ở
   260	 * mảnh sau nên KHÔNG bị coi là liệt kê.
   261	 */
   262	function isSingleStatementRun(run: string[]): boolean {
   263	  if (run.length < 2) return false
   264	  const rest = run.slice(1)
   265	  if (rest.some((f) => LIST_COORD_INITIAL.test(f))) return true
   266	  if (rest.some((f) => LIST_COORD_ANY.test(f) && !JUDGEMENT_ANY.test(f))) return true
   267	  return FRONTED_ADJUNCT.test(run[0]!)
   268	}
   269	
   270	/** Cụm trong ngoặc đơn không được tách: dấu câu bên trong là của cụm, không của câu. */
   271	function maskParentheticals(text: string): { masked: string; restore: (s: string) => string } {
   272	  const store: string[] = []
   273	  const masked = text.replace(/\([^()]*\)/gu, (m) => {
   274	    store.push(m)
   275	    return `␀${store.length - 1}␀`
   276	  })
   277	  return {
   278	    masked,
   279	    restore: (s) => s.replace(/␀(\d+)␀/gu, (_m, n: string) => store[Number(n)] ?? ''),
   280	  }
   281	}
   282	
   283	/**
   284	 * Ranh giới mệnh đề, có GIỮ LẠI dấu phân cách để biết chỗ nào là dấu phẩy.
   285	 *
   286	 * `\.(?!\d)` — dấu chấm đứng trước CHỮ SỐ không kết câu. Tiếng Việt dùng dấu
   287	 * chấm phân cách nghìn ("1.000") và output thật cũng chứa số thập phân kiểu Anh
   288	 * ("0.7262"); cắt ở đó băm nát câu và làm phép đếm U1 mất nghĩa.
   289	 * Dấu phẩy chỉ tính khi có khoảng trắng theo sau, nên "1,5%" vốn đã an toàn.
   290	 *
   291	 * KHÔNG bọc liên từ trong `\b...\b`: "và"/"hoặc" kết thúc bằng chữ có dấu nên
   292	 * `\b` phía sau là nhánh chết với cờ `u`. `\s+` hai bên đã là biên.
   293	 *
   294	 * "và" KHÔNG nằm trong danh sách này, có chủ ý: nó nối DANH NGỮ cũng nhiều như
   295	 * nối mệnh đề, nên tách ở đó sẽ đếm "…vì impressions và CTR có độ phủ 0%" —
   296	 * một phát biểu, chủ ngữ ghép — thành hai. Vai LIỆT KÊ của "và" được xử lý ở
   297	 * `isSingleStatementRun`, nơi có ngữ cảnh của cả chuỗi mảnh.
   298	 *
   299	 * GẠCH NGANG DÀI từng được thêm rồi GỠ RA: output thật dùng nó để ghép danh ngữ
   300	 * ("quyết định phân phối–packaging", "nhóm giữ chân cao–views thấp").
   301	 *
   302	 * GIỚI HẠN CÒN LẠI: hai phán xét nối bằng "và" trần ("CTR thấp và impressions
   303	 * thấp") vẫn được đếm là MỘT. Xem creator_specs/PHASE4_TRUST_BOUNDARIES.md.
   304	 */
   305	const CLAUSE_SEPARATOR =
   306	  /((?:\.(?!\d)|[!?;:\n])|,\s+|\s+(?:nhưng|còn|đồng thời|trong khi|tuy nhiên|mặt khác|ngoài ra)\s+)/iu
   307	
   308	export function clausesOf(text: string): string[] {
   309	  const { masked, restore } = maskParentheticals(text)
   310	
   311	  // Tách nhưng GIỮ dấu phân cách: `split` với nhóm bắt trả về xen kẽ
   312	  // [mảnh, dấu, mảnh, dấu, …], nhờ đó phân biệt được ranh giới DẤU PHẨY với các
   313	  // ranh giới khác. Chỉ dấu phẩy mới được xét gộp lại.
   314	  const parts = masked.split(CLAUSE_SEPARATOR)
   315	  const frags: string[] = []
   316	  const seps: string[] = []
   317	  parts.forEach((p, i) => {
   318	    if (i % 2 === 0) frags.push((p ?? '').trim())
   319	    else seps.push(p ?? '')
   320	  })
   321	
   322	  const out: string[] = []
   323	  let i = 0
   324	  while (i < frags.length) {
   325	    // Chuỗi tối đa các mảnh nối liên tiếp bằng DẤU PHẨY, dừng trước một mảnh mở
   326	    // đầu bằng liên từ đối lập/nhân quả — mảnh đó luôn là phát biểu riêng.
   327	    let j = i
   328	    while (
   329	      j < frags.length - 1 &&
   330	      /^,/u.test(seps[j] ?? '') &&
   331	      !NEW_CLAUSE_INITIAL.test(frags[j + 1] ?? '')
   332	    ) {
   333	      j++
   334	    }
   335	    const run = frags.slice(i, j + 1).filter(Boolean)
   336	    if (run.length > 1 && isSingleStatementRun(run)) out.push(run.join(', '))
   337	    else out.push(...run)
   338	    i = j + 1
   339	  }
   340	
   341	  return out.map(restore).map((x) => x.trim()).filter(Boolean)
   342	}
   343	
   344	
   345	/** Cắt một đoạn quanh vị trí khớp, để báo cáo chỉ đúng chỗ sai. */
   346	function excerptAround(text: string, match: RegExpExecArray | null, span = 90): string {
   347	  if (!match) return text.slice(0, span * 2)
   348	  const start = Math.max(0, match.index - span)
   349	  const end = Math.min(text.length, match.index + match[0].length + span)
   350	  return (start > 0 ? '…' : '') + text.slice(start, end) + (end < text.length ? '…' : '')
   351	}
   352	
   353	export interface ValidationReport {
   354	  passed: boolean
   355	  structuralIssues: ValidationIssue[]
   356	  evidenceIssues: ValidationIssue[]
   357	  claimIssues: ValidationIssue[]
   358	  qualityIssues: ValidationIssue[]
   359	  evidenceResolutionRate: number | null
   360	  totalEvidenceRefs: number
   361	  unresolvedEvidenceRefs: number
   362	  causalViolations: number
   363	  ctrViolations: number
   364	  unsupportedMetricViolations: number
   365	  counts: {
   366	    findings: number
   367	    hypotheses: number
   368	    recommendations: number
   369	    experiments: number
   370	  }
   371	}
   372	
   373	/**
   374	 * Cụm từ nhân quả bị cấm.
   375	 *
   376	 * Dùng biên từ (`\b` hoặc khoảng trắng) chứ không tìm chuỗi con: "do" là chuỗi
   377	 * con của "doanh thu", "độ dài", "do dự"..., và tìm thô sẽ sinh ra hàng loạt
   378	 * báo động giả rồi khiến cả bộ kiểm định bị bỏ qua.
   379	 */
   380	/**
   381	 * Danh từ chỉ KẾT QUẢ HIỆU SUẤT.
   382	 *
   383	 * "A làm giảm B" chỉ là khẳng định nhân quả đáng chặn khi B là một kết quả hiệu
   384	 * suất. Câu "độ đầy đủ dữ liệu thấp làm giảm ĐỘ TIN CẬY" nói về PHƯƠNG PHÁP, và
   385	 * đó chính là kiểu lập luận ta MUỐN mô hình đưa ra — chặn nó là dạy nó nói mơ hồ.
   386	 * Ví dụ thật đã bị báo động giả:
   387	 *   "dateCompleteness thấp làm giảm tin cậy xu hướng kênh"
   388	 */
   389	const PERF_OBJECT =
   390	  '(?:lượt xem|view\\w*|retention|giữ chân|tiếp cận|reach|đăng ký|subscriber\\w*|tương tác|engagement|hiệu suất|performance|thứ hạng|ranking|ctr|impressions?)'
   391	
   392	const CAUSAL_PATTERNS: Array<{ re: RegExp; label: string }> = [
   393	  { re: /\bgây ra\b/iu, label: 'gây ra' },
   394	  { re: /\bdẫn (?:tới|đến)\b/iu, label: 'dẫn tới' },
   395	  { re: /\bchứng minh (?:rằng|là)\b/iu, label: 'chứng minh rằng' },
   396	  { re: /\bnguyên nhân là\b/iu, label: 'nguyên nhân là' },
   397	  {
   398	    re: new RegExp(`\\blàm (?:giảm|tăng)\\s+(?:\\S+\\s+){0,2}?${PERF_OBJECT}`, 'iu'),
   399	    label: 'làm giảm/tăng <hiệu suất>',
   400	  },
   401	  {
   402	    re: new RegExp(`\\bkhiến (?:cho\\s+)?(?:\\S+\\s+){0,3}?${PERF_OBJECT}\\s+(?:giảm|tăng)`, 'iu'),
   403	    label: 'khiến <hiệu suất> giảm/tăng',
   404	  },
   405	  { re: /\bdo\s+(?:tiêu đề|thumbnail|giờ đăng|thuật toán)\b/iu, label: 'do <yếu tố>' },
   406	  { re: /\bvì\s+(?:tiêu đề|thumbnail|giờ đăng|thuật toán)\b/iu, label: 'vì <yếu tố>' },
   407	  { re: /\bcaused\b/i, label: 'caused' },
   408	  { re: /\bbecause of\b/i, label: 'because of' },
   409	  { re: /\bresulted from\b/i, label: 'resulted from' },
   410	  { re: /\bproved?\b(?!\s*(?:n't|not))/i, label: 'proved' },
   411	  { re: /\bled to\b/i, label: 'led to' },
   412	  { re: /\bdue to\b/i, label: 'due to' },
   413	  { re: /\bthe (?:thumbnail|title) failed\b/i, label: 'the thumbnail/title failed' },
   414	  { re: /\balgorithm (?:suppressed|penalized|throttled)\b/i, label: 'algorithm suppressed' },
   415	]
   416	
   417	/**
   418	 * Cụm từ về impressions/CTR/packaging bị cấm khi độ phủ = 0.
   419	 *
   420	 * Chỉ chặn KẾT LUẬN, không chặn việc NHẮC TỚI: câu "không có dữ liệu CTR nên
   421	 * chưa kết luận được" là đúng đắn và phải được phép. Vì thế các mẫu dưới đây
   422	 * đều nhắm vào lời khẳng định, và có bộ lọc phủ định ở `mentionsMissingness`.
   423	 */
   424	/**
   425	 * Biên từ HIỂU UNICODE.
   426	 *
   427	 * `\b` chỉ tính theo `\w` = [A-Za-z0-9_]. Mọi cụm tiếng Việt kết thúc bằng chữ
   428	 * có dấu — "hiệu quả", "hình thu nhỏ" — khi bọc trong `\b...\b` sẽ thành NHÁNH
   429	 * CHẾT: không bao giờ khớp được, và không có gì báo. Đây là lần thứ ba cùng một
   430	 * cái bẫy trong tệp này (trước đó là "0%" và "thay vì"), nên nó được đặt tên và
   780	  report: ValidationReport
   781	  output: CursorOutput | null
   782	  failureClass:
   783	    | 'NONE'
   784	    | 'INVALID_JSON'
   785	    | 'PROSE_OUTSIDE_JSON'
   786	    | 'SCHEMA_MISMATCH'
   787	    | 'MISSING_REQUIRED_FIELD'
   788	    | 'UNSUPPORTED_SCHEMA_VERSION'
   789	    | 'UNSUPPORTED_CLAIM'
   790	    | 'EVIDENCE_UNRESOLVED'
   791	  /** Lỗi ngắn gọn để đưa vào prompt sửa lỗi. */
   792	  repairErrors: string[]
   793	}
   794	
   795	export function validateCursorOutput(input: ValidateInput): ValidateResult {
   796	  const structuralIssues: ValidationIssue[] = []
   797	  const evidenceIssues: ValidationIssue[] = []
   798	  const claimIssues: ValidationIssue[] = []
   799	  const qualityIssues: ValidationIssue[] = []
   800	  const repairErrors: string[] = []
   801	
   802	  const emptyReport = (): ValidationReport => ({
   803	    passed: false,
   804	    structuralIssues,
   805	    evidenceIssues,
   806	    claimIssues,
   807	    qualityIssues,
   808	    evidenceResolutionRate: null,
   809	    totalEvidenceRefs: 0,
   810	    unresolvedEvidenceRefs: 0,
   811	    causalViolations: 0,
   812	    ctrViolations: 0,
   813	    unsupportedMetricViolations: 0,
   814	    counts: { findings: 0, hypotheses: 0, recommendations: 0, experiments: 0 },
   815	  })
   816	
   817	  // --- 1. Cấu trúc ---------------------------------------------------------
   818	  let parsed: unknown
   819	  try {
   820	    parsed = JSON.parse(input.raw)
   821	  } catch (err) {
   822	    structuralIssues.push({
   823	      rule: 'json_parse',
   824	      severity: 'BLOCKER',
   825	      message: `Không parse được JSON: ${err instanceof Error ? err.message : 'lỗi không rõ'}`,
   826	    })
   827	    repairErrors.push('Output không phải JSON hợp lệ. Trả về DUY NHẤT một object JSON.')
   828	    return { report: emptyReport(), output: null, failureClass: 'INVALID_JSON', repairErrors }
   829	  }
   830	
   831	  if (input.hadProseOutsideJson) {
   832	    // BLOCKER, không phải MEDIUM.
   833	    //
   834	    // Hợp đồng nói "chỉ trả về một object JSON". Trước đây vi phạm này chỉ là
   835	    // MEDIUM nên không ảnh hưởng `passed`, và phần văn bản ngoài JSON bị vứt đi
   836	    // mà không hề được kiểm — mô hình có thể viết một câu nhân quả/CTR ở ngoài
   837	    // rồi kèm một JSON sạch, và lần chạy vẫn được ghi SUCCEEDED.
   838	    //
   839	    // Đây là thất bại KỸ THUẬT (sai định dạng) nên ĐƯỢC phép thử lại. Nhưng nếu
   840	    // phần văn bản đó chứa khẳng định bị cấm thì nó thành thất bại NỘI DUNG và
   841	    // không được thử lại — xử lý ở phần quét khẳng định bên dưới.
   842	    structuralIssues.push({
   843	      rule: 'prose_outside_json',
   844	      severity: 'BLOCKER',
   845	      message: 'Có văn bản ngoài object JSON — hợp đồng yêu cầu CHỈ một object JSON.',
   846	    })
   847	    repairErrors.push('Trả về DUY NHẤT một object JSON, không kèm văn bản nào ngoài nó.')
   848	  }
   849	
   850	  const version = (parsed as { schemaVersion?: unknown })?.schemaVersion
   851	  // Payload schema 1 bị TỪ CHỐI dứt khoát, không "tương thích ngược" âm thầm.
   852	  //
   853	  // Chấp nhận 1.0 nghĩa là chấp nhận một payload KHÔNG có `metricClaims` — tức
   854	  // là mất toàn bộ tầng khai báo ngữ nghĩa mà 2.0 sinh ra để có. Một payload
   855	  // yếu hơn lọt qua vì "tương thích" là đúng kiểu thành công giả.
   856	  if (typeof version === 'string' && (LEGACY_SCHEMA_VERSIONS as readonly string[]).includes(version)) {
   857	    structuralIssues.push({
   858	      rule: 'legacy_schema_version',
   859	      severity: 'BLOCKER',
   860	      message:
   861	        `schemaVersion ${version} là bản CŨ (thiếu metricClaims). ` +
   862	        `Lần chạy này yêu cầu ${CURSOR_OUTPUT_SCHEMA_VERSION}.`,
   863	    })
   864	    repairErrors.push(`schemaVersion phải đúng bằng "${CURSOR_OUTPUT_SCHEMA_VERSION}".`)
   865	    return {
   866	      report: emptyReport(),
   867	      output: null,
   868	      failureClass: 'UNSUPPORTED_SCHEMA_VERSION',
   869	      repairErrors,
   870	    }
   871	  }
   872	  if (version !== undefined && version !== CURSOR_OUTPUT_SCHEMA_VERSION) {
   873	    structuralIssues.push({
   874	      rule: 'schema_version',
   875	      severity: 'BLOCKER',
   876	      message: `schemaVersion không hỗ trợ: ${String(version)}`,
   877	    })
   878	    repairErrors.push(`schemaVersion phải đúng bằng "${CURSOR_OUTPUT_SCHEMA_VERSION}".`)
   879	    return {
   880	      report: emptyReport(),
   881	      output: null,
   882	      failureClass: 'UNSUPPORTED_SCHEMA_VERSION',
   883	      repairErrors,
   884	    }
   885	  }
   886	
   887	  const result = cursorOutputSchema.safeParse(parsed)
   888	  if (!result.success) {
   889	    for (const issue of result.error.issues.slice(0, 25)) {
   890	      structuralIssues.push({
   891	        rule: 'schema',
   892	        severity: 'BLOCKER',
   893	        message: issue.message,
   894	        path: issue.path.join('.'),
   895	      })
   896	      repairErrors.push(`${issue.path.join('.') || '(gốc)'}: ${issue.message}`)
   897	    }
   898	    const missingRequired = result.error.issues.some((i) => i.code === 'invalid_type')
   899	    return {
   900	      report: emptyReport(),
   901	      output: null,
   902	      failureClass: missingRequired ? 'MISSING_REQUIRED_FIELD' : 'SCHEMA_MISMATCH',
   903	      repairErrors,
   904	    }
   905	  }
   906	
   907	  const output = result.data
   908	
   909	  // ID phải duy nhất trong từng nhóm.
   910	  for (const [name, arr] of [
   911	    ['keyFindings', output.keyFindings],
   912	    ['hypotheses', output.hypotheses],
   913	    ['recommendations', output.recommendations],
   914	    ['experiments', output.experiments],
   915	  ] as const) {
   916	    const ids = (arr as Array<{ id: string }>).map((x) => x.id)
   917	    const dupes = ids.filter((id, i) => ids.indexOf(id) !== i)
   918	    if (dupes.length) {
   919	      structuralIssues.push({
   920	        rule: 'duplicate_ids',
   921	        severity: 'BLOCKER',
   922	        message: `${name} có id trùng: ${[...new Set(dupes)].join(', ')}`,
   923	      })
   924	      repairErrors.push(`${name}: id phải duy nhất (trùng: ${[...new Set(dupes)].join(', ')}).`)
   925	    }
   926	  }
   927	
   928	  // Thí nghiệm phải trỏ tới giả thuyết có thật.
   929	  const hypothesisIds = new Set(output.hypotheses.map((h) => h.id))
   930	  for (const [i, e] of output.experiments.entries()) {
   931	    if (!hypothesisIds.has(e.hypothesisId)) {
   932	      structuralIssues.push({
   933	        rule: 'dangling_hypothesis_ref',
   934	        severity: 'BLOCKER',
   935	        message: `experiments[${i}].hypothesisId "${e.hypothesisId}" không tồn tại`,
   936	        path: `experiments[${i}].hypothesisId`,
   937	      })
   938	      repairErrors.push(`experiments[${i}].hypothesisId phải là một id có trong hypotheses.`)
   939	    }
   940	  }
   941	
   942	  // --- 2. Bằng chứng -------------------------------------------------------
   943	  // Cho phép trích dẫn CHÉO NỘI BỘ: một khuyến nghị dựa trên chính phát hiện
   944	  // F-00x của nó là cách viết tự nhiên và hợp lệ. Chỉ cần id đó thực sự tồn tại
   945	  // trong output — điều được kiểm ngay dưới đây.
   946	  const internalIds = new Set<string>([
   947	    ...output.keyFindings.map((f) => f.id),
   948	    ...output.hypotheses.map((h) => h.id),
   949	  ])
   950	  const allowed = new Set([...input.allowedEvidenceIds, ...internalIds])
   951	  const allowedVideos = new Set(input.allowedVideoIds)
   952	  let totalRefs = 0
   953	  let unresolvedRefs = 0
   954	
   955	  const checkRefs = (ids: string[], path: string): void => {
   956	    for (const id of ids) {
   957	      totalRefs++
   958	      if (!allowed.has(id)) {
   959	        unresolvedRefs++
   960	        evidenceIssues.push({
   961	          rule: 'unknown_evidence_id',
   962	          severity: 'BLOCKER',
   963	          message: `Evidence id "${id}" không có trong gói đầu vào`,
   964	          path,
   965	        })
   966	      }
   967	    }
   968	  }
   969	
