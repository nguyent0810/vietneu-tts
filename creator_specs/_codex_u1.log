  },
  EFFECTIVE: {
    self: /(?:hiệu quả|\btốt\b|\beffective\b)/iu,
    opposite: /(?:không hiệu quả|\bkém\b|\bineffective\b)/iu,
  },
  INEFFECTIVE: {
