   601	  const before = text.slice(Math.max(0, matchIndex - 50), matchIndex)
   602	  // "thay vì X" nghĩa là KHÔNG làm X — dạng phủ định rất hay gặp trong khuyến
   603	  // nghị: "...thay vì đổi thumbnail hàng loạt" là lời khuyên ĐỪNG đụng vào
   604	  // thumbnail, tức ngược hẳn với một kết luận về thumbnail. Ca thật từ phong_thuy.
   605	  return NEGATION_WORDS.test(before)
   606	}
   607	
