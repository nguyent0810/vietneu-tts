   570	    if (m.index === g.lastIndex) g.lastIndex++
   571	    // KHÔNG đặt trần số lần khớp.
   572	    //
   573	    // Bản trước dừng ở 50. Trần đó âm thầm đổi NGỮ NGHĨA kiểm định: 50 câu có
   574	    // rào đón đứng trước là đủ để đẩy một câu khẳng định trần ra ngoài vùng
   575	    // quét, và trường 800 ký tự thừa chỗ cho việc đó. Các mẫu ở đây không khớp
   576	    // chuỗi rỗng, và `lastIndex` luôn tiến, nên vòng lặp chắc chắn dừng.
   577	  }
   578	  return out
   579	}
   580	
   581	/**
   582	 * "thay vì X" / "instead of X" — phủ định một HÀNH ĐỘNG.
   583	 *
   584	 * Tách riêng khỏi bộ từ phủ định chung vì chỉ nhóm này được phép miễn trừ khi
   585	 * nằm GIỮA phán xét và chỉ số.
   586	 */
   587	const INSTEAD_OF = /(?:thay vì|instead of)/iu
   588	
   589	/** Từ phủ định dùng cho phép kiểm PHÍA TRƯỚC chỗ khớp. */
   590	/**
   591	 * Cụm kết thúc bằng chữ cái NGOÀI ASCII phải nằm ngoài cặp `\b...\b`.
   592	 *
   593	 * Với cờ `u`, `\b` chỉ tính theo `\w` = [A-Za-z0-9_]. "thay vì" kết thúc bằng
   594	 * "ì" nên `\b` phía sau KHÔNG BAO GIỜ khớp, biến nhánh đó thành nhánh chết —
   595	 * đúng cái bẫy đã gặp với mẫu "0%". Test "thay vì X" là thứ phát hiện ra.
   596	 */
   597	const NEGATION_WORDS =
   598	  /(?:\b(?:không|chưa|tránh|khỏi|no|not|avoid|without|never|exclude)\b|thay vì|instead of)/iu
   599	
