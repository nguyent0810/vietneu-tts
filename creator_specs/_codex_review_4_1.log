   199	/** Cắt một đoạn quanh vị trí khớp, để báo cáo chỉ đúng chỗ sai. */
   200	function excerptAround(text: string, match: RegExpExecArray | null, span = 90): string {
   201	  if (!match) return text.slice(0, span * 2)
   202	  const start = Math.max(0, match.index - span)
   203	  const end = Math.min(text.length, match.index + match[0].length + span)
   204	  return (start > 0 ? '…' : '') + text.slice(start, end) + (end < text.length ? '…' : '')
   205	}
