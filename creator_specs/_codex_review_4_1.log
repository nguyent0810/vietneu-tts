   246	const CAUSAL_PATTERNS: Array<{ re: RegExp; label: string }> = [
   247	  { re: /\bgây ra\b/iu, label: 'gây ra' },
   248	  { re: /\bdẫn (?:tới|đến)\b/iu, label: 'dẫn tới' },
   249	  { re: /\bchứng minh (?:rằng|là)\b/iu, label: 'chứng minh rằng' },
   250	  { re: /\bnguyên nhân là\b/iu, label: 'nguyên nhân là' },
   251	  {
   252	    re: new RegExp(`\\blàm (?:giảm|tăng)\\s+(?:\\S+\\s+){0,2}?${PERF_OBJECT}`, 'iu'),
   253	    label: 'làm giảm/tăng <hiệu suất>',
   254	  },
   255	  {
   256	    re: new RegExp(`\\bkhiến (?:cho\\s+)?(?:\\S+\\s+){0,3}?${PERF_OBJECT}\\s+(?:giảm|tăng)`, 'iu'),
   257	    label: 'khiến <hiệu suất> giảm/tăng',
   258	  },
   259	  { re: /\bdo\s+(?:tiêu đề|thumbnail|giờ đăng|thuật toán)\b/iu, label: 'do <yếu tố>' },
   260	  { re: /\bvì\s+(?:tiêu đề|thumbnail|giờ đăng|thuật toán)\b/iu, label: 'vì <yếu tố>' },
   261	  { re: /\bcaused\b/i, label: 'caused' },
   262	  { re: /\bbecause of\b/i, label: 'because of' },
   263	  { re: /\bresulted from\b/i, label: 'resulted from' },
   264	  { re: /\bproved?\b(?!\s*(?:n't|not))/i, label: 'proved' },
   265	  { re: /\bled to\b/i, label: 'led to' },
   266	  { re: /\bdue to\b/i, label: 'due to' },
   267	  { re: /\bthe (?:thumbnail|title) failed\b/i, label: 'the thumbnail/title failed' },
   268	  { re: /\balgorithm (?:suppressed|penalized|throttled)\b/i, label: 'algorithm suppressed' },
   269	]
   270	
   271	/**
   272	 * Cụm từ về impressions/CTR/packaging bị cấm khi độ phủ = 0.
   273	 *
   274	 * Chỉ chặn KẾT LUẬN, không chặn việc NHẮC TỚI: câu "không có dữ liệu CTR nên
   275	 * chưa kết luận được" là đúng đắn và phải được phép. Vì thế các mẫu dưới đây
   276	 * đều nhắm vào lời khẳng định, và có bộ lọc phủ định ở `mentionsMissingness`.
   277	 */
   278	/**
   279	 * Biên từ HIỂU UNICODE.
   280	 *
   281	 * `\b` chỉ tính theo `\w` = [A-Za-z0-9_]. Mọi cụm tiếng Việt kết thúc bằng chữ
   282	 * có dấu — "hiệu quả", "hình thu nhỏ" — khi bọc trong `\b...\b` sẽ thành NHÁNH
   283	 * CHẾT: không bao giờ khớp được, và không có gì báo. Đây là lần thứ ba cùng một
   284	 * cái bẫy trong tệp này (trước đó là "0%" và "thay vì"), nên nó được đặt tên và
   285	 * dùng chung thay vì sửa từng chỗ.
   286	 */
   287	const UB = '(?<![\\p{L}\\p{N}_])'
   288	const UE = '(?![\\p{L}\\p{N}_])'
   289	
   290	const CTR_SUBJECT = '(?:ctr|click-?through|impressions?|thumbnail|hình thu nhỏ|tỉ lệ nhấp)'
   291	const CTR_JUDGEMENT = '(?:thấp|cao|kém|tốt|yếu|mạnh|hiệu quả|hấp dẫn|giảm|tăng|low|high|poor|strong|weak|effective|dropped|increased|underperform\\w*|outperform\\w*)'
   292	
   293	/**
   294	 * Bắt phán xét về CTR/impressions/thumbnail theo CẢ HAI chiều ngữ pháp.
   295	 *
   296	 * Chỉ bắt một chiều (danh từ trước tính từ) sẽ bỏ lọt "the HIGH number of
   297	 * IMPRESSIONS" — đúng dạng câu tiếng Anh tự nhiên nhất, và là một vi phạm thật.
   298	 * Kiểm chứng bằng test `catches judgement stated before the metric`.
   299	 */
   300	const CTR_CLAIM_PATTERNS: Array<{ re: RegExp; label: string }> = [
   301	  {
   302	    // Cấm dấu câu ở giữa và giới hạn 30 ký tự: phán xét phải THỰC SỰ bổ nghĩa
   303	    // cho chỉ số, không phải chỉ đứng gần nó.
   304	    //
   305	    // Với cửa sổ rộng, câu "Khi có impressions: so sánh retention cao/reach
   306	    // thấp..." bị bắt nhầm — "cao"/"thấp" thuộc về retention và reach, còn
   307	    // "impressions" chỉ là điều kiện tương lai. Vế "CTR is low" vẫn khớp.
   308	    // Liên từ ĐẲNG LẬP cũng kết thúc vùng bổ nghĩa.
   309	    //
   310	    // "Độ phủ impressions/CTR >0 và observedDates tăng" — "tăng" thuộc về
   311	    // observedDates ở vế sau "và", không thuộc về CTR. Câu này là MỤC TIÊU THU
   312	    // THẬP dữ liệu, không phải kết luận về CTR. Ca thật từ hinh_su.
   313	    re: new RegExp(
   314	      `${UB}${CTR_SUBJECT}${UE}(?:(?!${UB}(?:và|and)${UE})[^.!?,;:()–—/]){0,30}?${UB}${CTR_JUDGEMENT}${UE}`,
   315	      'iu',
   316	    ),
   317	    label: 'kết luận về CTR/impressions/thumbnail',
   318	  },
   319	  {
   320	    // Chiều NGƯỢC phải chặt hơn nhiều: cấm dấu câu ở giữa và giới hạn 25 ký tự,
   321	    // để phán xét thực sự BỔ NGHĨA cho chỉ số.
   322	    //
   323	    // Với cửa sổ rộng, câu "retention cao–reach thấp, ... (không dùng CTR làm
   324	    // tiêu chí)" bị bắt nhầm: "thấp" thuộc về "reach", không thuộc về "CTR".
   325	    // Vế "the high number of impressions" vẫn khớp vì không có dấu câu chen vào.
   326	    // Liên từ MỤC ĐÍCH / KẾT QUẢ cũng kết thúc vùng bổ nghĩa.
   327	    //
   328	    // "views quá thấp ĐỂ ổn định CTR" và "sample size view thấp LÀM CTR nhiễu"
   329	    // đều là phát biểu về ĐỘ TIN CẬY PHÉP ĐO: phán xét "thấp" thuộc về views /
   330	    // cỡ mẫu, còn CTR là thứ ĐƯỢC ĐO, không phải thứ bị phán xét. Cả hai nằm ở
   331	    // `stopConditions` và `interpretationRisks` — đúng những ô sinh ra để chứa
   332	    // cảnh báo phương pháp. Chặn chúng là phạt mô hình vì nói đúng về giới hạn
   333	    // đo lường. Hai câu này đến từ lần chạy hinh_su thật.
   334	    re: new RegExp(
   335	      `${UB}${CTR_JUDGEMENT}${UE}(?:(?!${UB}(?:để|làm|khiến|nên)${UE})[^.!?,;()–—]){0,25}?${UB}${CTR_SUBJECT}${UE}`,
   336	      'iu',
   337	    ),
   338	    label: 'kết luận về CTR/impressions/thumbnail (phán xét đứng trước)',
   339	  },
   340	]
   341	
   342	/**
   343	 * Câu đang NÓI VỀ việc thiếu dữ liệu thì không tính là vi phạm.
   344	 *
   345	 * "impressions/CTR có độ phủ 0% nên chưa kết luận được" là câu ĐÚNG ĐẮN và phải
   346	 * được phép — nếu không, mô hình bị phạt vì nói thật về giới hạn dữ liệu.
   347	 *
   348	 * Lưu ý về regex: mẫu "0%" KHÔNG được bọc trong `\b...\b`. `%` là ký tự
   349	 * non-word nên biên từ phía sau không bao giờ khớp, khiến "0%" trở thành nhánh
   350	 * chết và mọi câu nói về độ phủ 0% bị coi là vi phạm. Bản đầu mắc đúng lỗi này
   351	 * và đã từ chối oan một lần chạy thật.
   352	 */
   353	function mentionsMissingness(text: string): boolean {
   354	  return (
   355	    /0\s*%/u.test(text) ||
   356	    /\b(?:unavailable|missing|not available|no data|zero coverage|insufficient|cannot be (?:determined|concluded|assessed|evaluated)|not assessable|not enough to conclude|do not treat as confirmed)\b/iu.test(
   357	      text,
   358	    ) ||
   359	    // Tiếng Việt: bắt cả các cách nói KIỀM CHẾ, không chỉ "thiếu dữ liệu".
   360	    //
   361	    // Hai câu sau đến từ output THẬT và đều bị báo động giả ở bản đầu — cả hai
   362	    // là hành vi ĐÚNG mà quy tắc này lẽ ra phải khuyến khích:
   363	    //   "...không đủ để kết luận tiêu đề/thumbnail."
   364	    //   "...không đổi thumbnail như giải pháp đã xác nhận"
   365	    // Phạt mô hình vì nói thật về giới hạn là cách nhanh nhất để dạy nó nói
   366	    // mập mờ hơn.
   367	    //
   368	    // ĐÃ GỠ "đã xác nhận": nó nghĩa là ĐÃ ĐƯỢC XÁC NHẬN, tức ngược hẳn với
   369	    // thiếu dữ liệu, nên "Thumbnail kém đã xác nhận." từng được tha oan. Câu
   370	    // gốc từng cần nó ("không đổi thumbnail như giải pháp đã xác nhận") vẫn
   371	    // được tha nhờ `hasLocalNegation` bắt chữ "không" đứng ngay trước.
   372	    /(?:không có|thiếu|chưa có|không khả dụng|không có dữ liệu|không đủ|chưa đủ|không thể kết luận|không kết luận được|không phân biệt được|không đánh giá được|không xác nhận|chưa xác nhận|không suy ra|chưa thể|trước khi kết luận|chờ|cần thu thập|bật đo|chưa kết luận)/iu.test(
   373	      text,
   374	    ) ||
   375	    // ĐIỀU KIỆN VỀ VIỆC CÓ DỮ LIỆU TRONG TƯƠNG LAI.
   376	    //
   377	    // "Khi có impressions: impressions thấp hay CTR thấp?" nói rằng hiện GIỜ
   378	    // chưa có impressions, và đặt câu hỏi chẩn đoán cho lúc có. Nó không khẳng
   379	    // định gì về CTR — nó là kế hoạch đo, đúng thứ ta muốn mô hình viết ra thay
   380	    // vì đoán bừa. Câu này đến từ một lần chạy phong_thuy thật và từng bị từ
   381	    // chối oan.
   382	    //
   383	    // Đây KHÔNG phải nới lỏng quy tắc CTR: quy tắc vẫn chặn mọi KẾT LUẬN. Cái
   384	    // được bổ sung là một cách diễn đạt sự THIẾU dữ liệu mà danh sách cũ chưa
   385	    // có — "khi nào có X" cũng là một cách nói "hiện chưa có X".
   386	    /(?:khi có|khi nào có|sau khi có|một khi có|khi thu thập được|khi bật được)\s/iu.test(text) ||
   387	    /\b(?:when|once)\s+\w*\s*(?:is |are |becomes? )?available\b/iu.test(text) ||
   388	    // Câu ĐỀ XUẤT THU THẬP dữ liệu, hoặc HOÃN kết luận, không phải câu khẳng
   389	    // định. Ví dụ thật: "bật đo impressions/CTR và chờ chín các video đáy TRƯỚC
   390	    // KHI kết luận kém hiệu quả" — đây là yêu cầu dữ liệu kèm hoãn kết luận,
   391	    // đúng hành vi mong muốn.
   392	    /\b(?:before concluding|once available|enable|start (?:measuring|tracking)|collect|await|pending)\b/iu.test(
   393	      text,
   394	    )
   395	  )
   396	}
   397	
   398	/**
   399	 * Phủ định NGAY TRƯỚC chỗ nhắc tới chỉ số.
   400	 *
   401	 * Danh sách cụm từ cố định không bao giờ đủ: mô hình diễn đạt sự kiềm chế bằng
   402	 * vô số cách ("không dùng CTR làm tiêu chí", "không lấy impressions để đánh
   403	 * giá"...). Quy tắc ngôn ngữ tổng quát hơn: một từ phủ định đứng sát trước chủ
   404	 * ngữ thì cả mệnh đề đó là phủ định, không phải khẳng định.
   405	 *
   406	 * Cửa sổ 50 ký tự: đủ để bắt "không dùng X làm Y" mà không vơ nhầm một phủ định
   407	 * ở mệnh đề hoàn toàn khác.
   408	 */
   409	/**
   410	 * MỌI lần khớp của một mẫu, không chỉ lần đầu.
   411	 *
   412	 * `exec` không cờ `g` chỉ trả về lần khớp đầu tiên. Khi lần đầu rơi vào một
   413	 * ngoại lệ hợp lệ, mọi vi phạm phía sau dùng cùng mẫu đó sẽ không bao giờ được
   414	 * kiểm — một lối lách im lặng.
   415	 *
   416	 * `lastIndex` được đẩy tiến ít nhất 1 để mẫu khớp rỗng không lặp vô hạn.
   417	 */
   418	function allMatches(re: RegExp, text: string): RegExpExecArray[] {
   419	  const g = new RegExp(re.source, re.flags.includes('g') ? re.flags : `${re.flags}g`)
   420	  const out: RegExpExecArray[] = []
   421	  let m: RegExpExecArray | null
   422	  while ((m = g.exec(text)) !== null) {
   423	    out.push(m)
   424	    if (m.index === g.lastIndex) g.lastIndex++
   425	    // KHÔNG đặt trần số lần khớp.
   426	    //
   427	    // Bản trước dừng ở 50. Trần đó âm thầm đổi NGỮ NGHĨA kiểm định: 50 câu có
   428	    // rào đón đứng trước là đủ để đẩy một câu khẳng định trần ra ngoài vùng
   429	    // quét, và trường 800 ký tự thừa chỗ cho việc đó. Các mẫu ở đây không khớp
   430	    // chuỗi rỗng, và `lastIndex` luôn tiến, nên vòng lặp chắc chắn dừng.
   431	  }
   432	  return out
   433	}
   434	
   435	/**
   436	 * "thay vì X" / "instead of X" — phủ định một HÀNH ĐỘNG.
   437	 *
   438	 * Tách riêng khỏi bộ từ phủ định chung vì chỉ nhóm này được phép miễn trừ khi
   439	 * nằm GIỮA phán xét và chỉ số.
   440	 */
   441	const INSTEAD_OF = /(?:thay vì|instead of)/iu
   442	
   443	/** Từ phủ định dùng cho phép kiểm PHÍA TRƯỚC chỗ khớp. */
   444	/**
   445	 * Cụm kết thúc bằng chữ cái NGOÀI ASCII phải nằm ngoài cặp `\b...\b`.
   446	 *
   447	 * Với cờ `u`, `\b` chỉ tính theo `\w` = [A-Za-z0-9_]. "thay vì" kết thúc bằng
   448	 * "ì" nên `\b` phía sau KHÔNG BAO GIỜ khớp, biến nhánh đó thành nhánh chết —
   449	 * đúng cái bẫy đã gặp với mẫu "0%". Test "thay vì X" là thứ phát hiện ra.
   450	 */
   451	const NEGATION_WORDS =
   452	  /(?:\b(?:không|chưa|tránh|khỏi|no|not|avoid|without|never|exclude)\b|thay vì|instead of)/iu
   453	
   454	function hasLocalNegation(text: string, matchIndex: number): boolean {
   455	  const before = text.slice(Math.max(0, matchIndex - 50), matchIndex)
   456	  // "thay vì X" nghĩa là KHÔNG làm X — dạng phủ định rất hay gặp trong khuyến
   457	  // nghị: "...thay vì đổi thumbnail hàng loạt" là lời khuyên ĐỪNG đụng vào
   458	  // thumbnail, tức ngược hẳn với một kết luận về thumbnail. Ca thật từ phong_thuy.
   459	  return NEGATION_WORDS.test(before)
   460	}
   461	
   462	/**
   463	 * Dấu hiệu ĐÃ RÀO ĐÓN — câu đang đề xuất chứ không khẳng định.
   464	 *
   465	 * Danh sách này lấy thẳng từ phần "từ ngữ nên dùng" của hợp đồng: "có thể cho
   466	 * thấy", "là giả thuyết hợp lý", "may indicate", "plausible hypothesis"...
   467	 */
   468	const HEDGE_PATTERN =
   469	  /(?:có thể|có lẽ|có khả năng|giả thuyết|chưa kiểm chứng|nghi ngờ|dường như|có liên hệ|phù hợp với|cần thêm bằng chứng|may |might |could |possibly|plausible|hypothes\w+|appears? to|consistent with|associated with|suggests?|unverified)/iu
   470	
   471	// Lưu ý: dùng "có khả năng" chứ KHÔNG dùng "khả năng" trần.
   472	// Trong tiếng Việt "khả năng" vừa nghĩa "possibility" (rào đón) vừa nghĩa
   473	// "ability" — nên "khả năng giữ chân" (retention ABILITY) từng bị hiểu nhầm là
   474	// đã rào đón, và một giả thuyết nhân quả trần trụi lọt qua kiểm định.
   475	
   476	/**
   477	 * Mọi chuỗi văn bản tự do trong output.
   478	 *
   479	 * `isHypothesis` quyết định mức nghiêm khắc với ngôn ngữ nhân quả. Một GIẢ
   480	 * THUYẾT, theo định nghĩa, đề xuất một cơ chế — cấm tuyệt đối ngôn ngữ nhân quả
   481	 * ở đó thì không thể phát biểu giả thuyết nào, và chính hợp đồng cũng gợi ý
   482	 * dùng "là giả thuyết hợp lý". Nên ở ngữ cảnh giả thuyết, cơ chế được phép NẾU
   483	 * có rào đón; còn ở phần khẳng định (tóm tắt, phát hiện, lý do khuyến nghị) thì
   484	 * ngôn ngữ nhân quả vẫn bị chặn tuyệt đối.
   485	 */
   486	function textFields(
   487	  output: CursorOutput,
   488	): Array<{ path: string; text: string; isHypothesis: boolean }> {
   489	  const out: Array<{ path: string; text: string; isHypothesis: boolean }> = []
   490	  const s = output.analysisSummary
   491	  const assert = (path: string, text: string) => out.push({ path, text, isHypothesis: false })
   492	  const hypo = (path: string, text: string) => out.push({ path, text, isHypothesis: true })
   493	  const assertEach = (base: string, xs: string[]) =>
   494	    xs.forEach((t, j) => assert(`${base}[${j}]`, t))
   495	  const hypoEach = (base: string, xs: string[]) => xs.forEach((t, j) => hypo(`${base}[${j}]`, t))
   496	
   497	  assert('analysisSummary.overallAssessment', s.overallAssessment)
   498	  assert('analysisSummary.confidenceRationale', s.confidenceRationale)
   499	  assert('analysisSummary.primaryConstraint', s.primaryConstraint)
   500	
   501	  output.keyFindings.forEach((f, i) => {
   502	    assert(`keyFindings[${i}].statement`, f.statement)
   503	    assert(`keyFindings[${i}].supportingReasoning`, f.supportingReasoning)
   504	    assertEach(`keyFindings[${i}].limitations`, f.limitations)
   505	  })
   506	  output.hypotheses.forEach((h, i) => {
   507	    hypo(`hypotheses[${i}].statement`, h.statement)
   508	    hypo(`hypotheses[${i}].validationMethod`, h.validationMethod)
   509	    hypoEach(`hypotheses[${i}].missingEvidence`, h.missingEvidence)
   510	  })
   511	  output.recommendations.forEach((r, i) => {
   512	    assert(`recommendations[${i}].action`, r.action)
   513	    assert(`recommendations[${i}].rationale`, r.rationale)
   514	    assert(`recommendations[${i}].successMetric`, r.successMetric)
   515	    assertEach(`recommendations[${i}].risks`, r.risks)
   516	  })
   517	  output.experiments.forEach((e, i) => {
   518	    // Thí nghiệm mô tả một thay đổi ĐỀ XUẤT để kiểm chứng -> cùng nhóm giả thuyết.
   519	    hypo(`experiments[${i}].change`, e.change)
   520	    hypo(`experiments[${i}].baseline`, e.baseline)
   521	    hypoEach(`experiments[${i}].successMetrics`, e.successMetrics)
   522	    hypoEach(`experiments[${i}].sampleLimitations`, e.sampleLimitations)
   523	    hypoEach(`experiments[${i}].stopConditions`, e.stopConditions)
   524	    hypoEach(`experiments[${i}].interpretationRisks`, e.interpretationRisks)
   525	  })
   526	
   527	  // Các trường dưới đây từng KHÔNG được quét. Đó là một lỗ thật, không phải
   528	  // thiếu sót hình thức: `manualReviewTargets[].reason` là chỗ tự nhiên nhất để
   529	  // viết "thumbnail kém dẫn tới lượt xem thấp" — vừa nhân quả vừa kết luận về
   530	  // thumbnail khi độ phủ impressions bằng 0 — và toàn bộ payload vẫn "ĐẠT".
   531	  // Quy tắc: MỌI chuỗi tự do đều bị quét; không có vùng nào miễn kiểm.
   532	  output.manualReviewTargets.forEach((m, i) => {
   533	    assert(`manualReviewTargets[${i}].reason`, m.reason)
   534	    assertEach(`manualReviewTargets[${i}].reviewQuestions`, m.reviewQuestions)
   535	  })
   536	  output.dataRequests.forEach((d, i) => {
   537	    assert(`dataRequests[${i}].metricOrArtifact`, d.metricOrArtifact)
   538	    assert(`dataRequests[${i}].reason`, d.reason)
   539	    assert(`dataRequests[${i}].decisionUnlocked`, d.decisionUnlocked)
   540	  })
   541	  // `explicitNonConclusions` là nơi mô hình liệt kê điều nó KHÔNG kết luận. Nội
   542	  // dung đúng đắn ở đây gần như luôn chứa phủ định, nên bộ lọc thiếu-dữ-liệu sẽ
   543	  // tha; nhưng quét vẫn cần, vì một khẳng định trá hình cũng có thể nấp ở đây.
   544	  assertEach('explicitNonConclusions', output.explicitNonConclusions)
   545	  return out
   546	}
   547	
   548	/**
   549	 * Tách câu để xét ngoại lệ theo TỪNG CÂU, không theo cả trường.
   550	 *
   551	 * Áp `mentionsMissingness` lên cả trường tạo ra một lối lách nguy hiểm: chỉ cần
   552	 * mở đầu bằng một câu miễn trừ đúng chuẩn là mọi khẳng định bị cấm phía sau đều
   553	 * được tha. Ví dụ thật của lối lách này:
   554	 *
   555	 *   "Không có dữ liệu CTR. Tuy nhiên thumbnail hiện tại kém và impressions thấp."
   556	 *
   557	 * Câu đầu hợp lệ, câu sau vi phạm — nhưng cả trường được tha. Tệ hơn: mô hình
   558	 * làm đúng yêu cầu "nêu rõ dữ liệu thiếu" lại chính là thứ mở khoá cho vi phạm.
   559	 * Vì vậy ngoại lệ chỉ áp cho câu CHỨA chỗ khớp.
   560	 */
   561	function sentenceAround(text: string, matchIndex: number): string {
   562	  const before = text.slice(0, matchIndex)
   563	  // Dấu hai chấm và dấu ba chấm CŨNG là ranh giới mệnh đề.
   564	  //
   565	  // Thiếu chúng, một mệnh đề miễn trừ nối bằng dấu hai chấm sẽ tha cho khẳng
   566	  // định đứng sau: "Không có dữ liệu CTR: thumbnail hiện tại kém." — vế trái
   567	  // nói thiếu dữ liệu, vế phải kết luận thẳng, và cả cụm được tha.
   568	  const start = Math.max(
   569	    before.lastIndexOf('.'),
   570	    before.lastIndexOf('!'),
   571	    before.lastIndexOf('?'),
   572	    before.lastIndexOf('\n'),
   573	    before.lastIndexOf(';'),
   574	    before.lastIndexOf(':'),
   575	    before.lastIndexOf('…'),
   576	  )
   577	  const rest = text.slice(matchIndex)
   578	  const endRel = rest.search(/[.!?;:…\n]/u)
   579	  const end = endRel === -1 ? text.length : matchIndex + endRel + 1
   580	  return text.slice(start + 1, end)
   581	}
   582	
   583	/**
   584	 * Mệnh đề NGHI VẤN không phải là kết luận.
   585	 *
   586	 * Quy tắc CTR chặn KẾT LUẬN. "Khi có impressions: impressions thấp hay CTR
   587	 * thấp?" là câu hỏi chẩn đoán cho lúc có dữ liệu — nó không khẳng định điều gì
   588	 * về CTR hiện tại, và đó chính là hành vi kiềm chế ta muốn khuyến khích.
   589	 *
   590	 * Sau khi dấu hai chấm trở thành ranh giới, vế phải đứng riêng và không còn
   591	 * mang dấu hiệu thiếu dữ liệu, nên cần nhận diện nó là câu hỏi.
   592	 *
   593	 * Rủi ro còn lại, có ý thức chấp nhận: câu hỏi TU TỪ ("Phải chăng CTR thấp?")
   594	 * vẫn là khẳng định trá hình. Ngoại lệ này chỉ áp cho quy tắc CTR, không áp cho
   595	 * ngôn ngữ nhân quả, và các trường liên quan (`reviewQuestions`) vốn được thiết
   596	 * kế để chứa câu hỏi.
   597	 */
   598	function isInterrogative(clause: string): boolean {
   599	  return clause.trimEnd().endsWith('?')
   600	}
   601	
   602	/**
   603	 * Mệnh đề ĐIỀU KIỆN không khẳng định điều gì là sự thật.
   604	 *
   605	 * "nếu CTR thấp + impressions thấp/cao sẽ hướng kiểm chứng khác nhau" mô tả
   606	 * cách xử lý KHI có dữ liệu; nó không nói CTR đang thấp. Đây là kế hoạch kiểm
   607	 * chứng — đúng thứ ta muốn mô hình viết thay vì đoán bừa. Cả hai ca thật
   608	 * (hinh_su và phong_thuy) đều thuộc dạng này.
   609	 *
   610	 * Song song với `isInterrogative`, và cũng chỉ áp cho quy tắc CTR: câu điều
   611	 * kiện KHÔNG được phép chứa ngôn ngữ nhân quả trần trụi.
   612	 *
   613	 * Rủi ro còn lại, có ý thức chấp nhận: một khẳng định có thể được nguỵ trang
   614	 * thành mệnh đề điều kiện. Đổi lại, phạt mô hình vì lập kế hoạch đo lường có
   615	 * điều kiện sẽ dạy nó nói mơ hồ hơn.
   616	 */
   617	function isConditional(clause: string): boolean {
   618	  return /\b(?:nếu|khi nào|nếu như|giả sử|if|when|once|should)\b/iu.test(clause)
   619	}
   620	
   621	export interface ValidateInput {
   622	  raw: string
   623	  pkg: AnalysisPackage
   624	  allowedEvidenceIds: string[]
   625	  allowedVideoIds: string[]
   626	  allowedCohortKeys: string[]
   627	  hadProseOutsideJson: boolean
   628	  /** Văn bản ngoài JSON — cũng là lời của mô hình, nên cũng phải bị quét. */
   629	  proseText?: string
   630	  strict?: boolean
   631	}
   632	
   633	export interface ValidateResult {
   634	  report: ValidationReport
   635	  output: CursorOutput | null
   636	  failureClass:
   637	    | 'NONE'
   638	    | 'INVALID_JSON'
   639	    | 'PROSE_OUTSIDE_JSON'
   640	    | 'SCHEMA_MISMATCH'
   641	    | 'MISSING_REQUIRED_FIELD'
   642	    | 'UNSUPPORTED_SCHEMA_VERSION'
   643	    | 'UNSUPPORTED_CLAIM'
   644	    | 'EVIDENCE_UNRESOLVED'
   645	  /** Lỗi ngắn gọn để đưa vào prompt sửa lỗi. */
   646	  repairErrors: string[]
   647	}
   648	
   649	export function validateCursorOutput(input: ValidateInput): ValidateResult {
   650	  const structuralIssues: ValidationIssue[] = []
   651	  const evidenceIssues: ValidationIssue[] = []
   652	  const claimIssues: ValidationIssue[] = []
   653	  const qualityIssues: ValidationIssue[] = []
   654	  const repairErrors: string[] = []
   655	
   656	  const emptyReport = (): ValidationReport => ({
   657	    passed: false,
   658	    structuralIssues,
   659	    evidenceIssues,
   660	    claimIssues,
   661	    qualityIssues,
   662	    evidenceResolutionRate: null,
   663	    totalEvidenceRefs: 0,
   664	    unresolvedEvidenceRefs: 0,
   665	    causalViolations: 0,
   666	    ctrViolations: 0,
   667	    unsupportedMetricViolations: 0,
   668	    counts: { findings: 0, hypotheses: 0, recommendations: 0, experiments: 0 },
   669	  })
   670	
   671	  // --- 1. Cấu trúc ---------------------------------------------------------
   672	  let parsed: unknown
   673	  try {
   674	    parsed = JSON.parse(input.raw)
   675	  } catch (err) {
   676	    structuralIssues.push({
   677	      rule: 'json_parse',
   678	      severity: 'BLOCKER',
   679	      message: `Không parse được JSON: ${err instanceof Error ? err.message : 'lỗi không rõ'}`,
   680	    })
   681	    repairErrors.push('Output không phải JSON hợp lệ. Trả về DUY NHẤT một object JSON.')
   682	    return { report: emptyReport(), output: null, failureClass: 'INVALID_JSON', repairErrors }
   683	  }
   684	
   685	  if (input.hadProseOutsideJson) {
   686	    // BLOCKER, không phải MEDIUM.
   687	    //
   688	    // Hợp đồng nói "chỉ trả về một object JSON". Trước đây vi phạm này chỉ là
   689	    // MEDIUM nên không ảnh hưởng `passed`, và phần văn bản ngoài JSON bị vứt đi
   690	    // mà không hề được kiểm — mô hình có thể viết một câu nhân quả/CTR ở ngoài
   691	    // rồi kèm một JSON sạch, và lần chạy vẫn được ghi SUCCEEDED.
   692	    //
   693	    // Đây là thất bại KỸ THUẬT (sai định dạng) nên ĐƯỢC phép thử lại. Nhưng nếu
   694	    // phần văn bản đó chứa khẳng định bị cấm thì nó thành thất bại NỘI DUNG và
   695	    // không được thử lại — xử lý ở phần quét khẳng định bên dưới.
   696	    structuralIssues.push({
   697	      rule: 'prose_outside_json',
   698	      severity: 'BLOCKER',
   699	      message: 'Có văn bản ngoài object JSON — hợp đồng yêu cầu CHỈ một object JSON.',
   700	    })
   701	    repairErrors.push('Trả về DUY NHẤT một object JSON, không kèm văn bản nào ngoài nó.')
   702	  }
   703	
   704	  const version = (parsed as { schemaVersion?: unknown })?.schemaVersion
   705	  // Payload schema 1 bị TỪ CHỐI dứt khoát, không "tương thích ngược" âm thầm.
   706	  //
   707	  // Chấp nhận 1.0 nghĩa là chấp nhận một payload KHÔNG có `metricClaims` — tức
   708	  // là mất toàn bộ tầng khai báo ngữ nghĩa mà 2.0 sinh ra để có. Một payload
   709	  // yếu hơn lọt qua vì "tương thích" là đúng kiểu thành công giả.
   710	  if (typeof version === 'string' && (LEGACY_SCHEMA_VERSIONS as readonly string[]).includes(version)) {
   711	    structuralIssues.push({
   712	      rule: 'legacy_schema_version',
   713	      severity: 'BLOCKER',
   714	      message:
   715	        `schemaVersion ${version} là bản CŨ (thiếu metricClaims). ` +
   716	        `Lần chạy này yêu cầu ${CURSOR_OUTPUT_SCHEMA_VERSION}.`,
   717	    })
   718	    repairErrors.push(`schemaVersion phải đúng bằng "${CURSOR_OUTPUT_SCHEMA_VERSION}".`)
   719	    return {
   720	      report: emptyReport(),
   721	      output: null,
   722	      failureClass: 'UNSUPPORTED_SCHEMA_VERSION',
   723	      repairErrors,
   724	    }
   725	  }
   726	  if (version !== undefined && version !== CURSOR_OUTPUT_SCHEMA_VERSION) {
   727	    structuralIssues.push({
   728	      rule: 'schema_version',
   729	      severity: 'BLOCKER',
   730	      message: `schemaVersion không hỗ trợ: ${String(version)}`,
   731	    })
   732	    repairErrors.push(`schemaVersion phải đúng bằng "${CURSOR_OUTPUT_SCHEMA_VERSION}".`)
   733	    return {
   734	      report: emptyReport(),
   735	      output: null,
   736	      failureClass: 'UNSUPPORTED_SCHEMA_VERSION',
   737	      repairErrors,
   738	    }
   739	  }
   740	
   741	  const result = cursorOutputSchema.safeParse(parsed)
   742	  if (!result.success) {
   743	    for (const issue of result.error.issues.slice(0, 25)) {
   744	      structuralIssues.push({
   745	        rule: 'schema',
   746	        severity: 'BLOCKER',
   747	        message: issue.message,
   748	        path: issue.path.join('.'),
   749	      })
   750	      repairErrors.push(`${issue.path.join('.') || '(gốc)'}: ${issue.message}`)
   751	    }
   752	    const missingRequired = result.error.issues.some((i) => i.code === 'invalid_type')
   753	    return {
   754	      report: emptyReport(),
   755	      output: null,
   756	      failureClass: missingRequired ? 'MISSING_REQUIRED_FIELD' : 'SCHEMA_MISMATCH',
   757	      repairErrors,
   758	    }
   759	  }
   760	
   761	  const output = result.data
   762	
   763	  // ID phải duy nhất trong từng nhóm.
   764	  for (const [name, arr] of [
   765	    ['keyFindings', output.keyFindings],
   766	    ['hypotheses', output.hypotheses],
   767	    ['recommendations', output.recommendations],
   768	    ['experiments', output.experiments],
   769	  ] as const) {
   770	    const ids = (arr as Array<{ id: string }>).map((x) => x.id)
   771	    const dupes = ids.filter((id, i) => ids.indexOf(id) !== i)
   772	    if (dupes.length) {
   773	      structuralIssues.push({
   774	        rule: 'duplicate_ids',
   775	        severity: 'BLOCKER',
   776	        message: `${name} có id trùng: ${[...new Set(dupes)].join(', ')}`,
   777	      })
   778	      repairErrors.push(`${name}: id phải duy nhất (trùng: ${[...new Set(dupes)].join(', ')}).`)
   779	    }
   780	  }
   781	
   782	  // Thí nghiệm phải trỏ tới giả thuyết có thật.
   783	  const hypothesisIds = new Set(output.hypotheses.map((h) => h.id))
   784	  for (const [i, e] of output.experiments.entries()) {
   785	    if (!hypothesisIds.has(e.hypothesisId)) {
   786	      structuralIssues.push({
   787	        rule: 'dangling_hypothesis_ref',
   788	        severity: 'BLOCKER',
   789	        message: `experiments[${i}].hypothesisId "${e.hypothesisId}" không tồn tại`,
   790	        path: `experiments[${i}].hypothesisId`,
   791	      })
   792	      repairErrors.push(`experiments[${i}].hypothesisId phải là một id có trong hypotheses.`)
   793	    }
   794	  }
   795	
   796	  // --- 2. Bằng chứng -------------------------------------------------------
   797	  // Cho phép trích dẫn CHÉO NỘI BỘ: một khuyến nghị dựa trên chính phát hiện
   798	  // F-00x của nó là cách viết tự nhiên và hợp lệ. Chỉ cần id đó thực sự tồn tại
   799	  // trong output — điều được kiểm ngay dưới đây.
   800	  const internalIds = new Set<string>([
   801	    ...output.keyFindings.map((f) => f.id),
   802	    ...output.hypotheses.map((h) => h.id),
   803	  ])
   804	  const allowed = new Set([...input.allowedEvidenceIds, ...internalIds])
   805	  const allowedVideos = new Set(input.allowedVideoIds)
   806	  let totalRefs = 0
   807	  let unresolvedRefs = 0
   808	
   809	  const checkRefs = (ids: string[], path: string): void => {
   810	    for (const id of ids) {
   811	      totalRefs++
   812	      if (!allowed.has(id)) {
   813	        unresolvedRefs++
   814	        evidenceIssues.push({
   815	          rule: 'unknown_evidence_id',
   816	          severity: 'BLOCKER',
   817	          message: `Evidence id "${id}" không có trong gói đầu vào`,
   818	          path,
   819	        })
   820	      }
   821	    }
   822	  }
   823	
   824	  output.keyFindings.forEach((f, i) => {
   825	    checkRefs(f.evidenceIds, `keyFindings[${i}].evidenceIds`)
   826	    checkRefs(f.contradictingEvidenceIds, `keyFindings[${i}].contradictingEvidenceIds`)
   827	  })
   828	  output.hypotheses.forEach((h, i) => {
   829	    checkRefs(h.supportingEvidenceIds, `hypotheses[${i}].supportingEvidenceIds`)
   830	    checkRefs(h.contradictingEvidenceIds, `hypotheses[${i}].contradictingEvidenceIds`)
   831	  })
   832	  output.recommendations.forEach((r, i) => {
   833	    checkRefs(r.evidenceIds, `recommendations[${i}].evidenceIds`)
   834	  })
   835	  const allowedCohorts = new Set(input.allowedCohortKeys)
   836	  output.manualReviewTargets.forEach((m, i) => {
   837	    checkRefs(m.evidenceIds, `manualReviewTargets[${i}].evidenceIds`)
   838	    totalRefs++
   839	    if (m.targetType === 'VIDEO') {
   840	      // Video phải thuộc ĐÚNG kênh đang phân tích — chặn tham chiếu chéo kênh.
   841	      if (!allowedVideos.has(m.targetId)) {
   842	        unresolvedRefs++
   843	        evidenceIssues.push({
   844	          rule: 'cross_channel_video',
   845	          severity: 'BLOCKER',
   846	          message: `manualReviewTargets[${i}].targetId "${m.targetId}" không phải video của kênh đang phân tích`,
   847	          path: `manualReviewTargets[${i}].targetId`,
   848	        })
   849	      }
   850	    } else if (!allowedCohorts.has(m.targetId)) {
   851	      unresolvedRefs++
   852	      evidenceIssues.push({
   853	        rule: 'unknown_cohort',
   854	        severity: 'BLOCKER',
   855	        message: `manualReviewTargets[${i}].targetId "${m.targetId}" không phải cohort có trong gói`,
   856	        path: `manualReviewTargets[${i}].targetId`,
   857	      })
   858	    }
   859	  })
   860	
   861	  if (unresolvedRefs > 0) {
   862	    repairErrors.push(
   863	      `${unresolvedRefs} evidence id không hợp lệ. Chỉ dùng id có trong danh sách EVIDENCE ID đã cho.`,
   864	    )
   865	  }
   866	
   867	  // --- 2b. Trích dẫn nội bộ phải NEO được về bằng chứng của gói ---------------
   868	  //
   869	  // Cho phép F-002 dựa trên F-001 là hợp lý. Nhưng chỉ kiểm "id có tồn tại" thì
   870	  // mở ra một lỗ hổng nghiêm trọng: F-001 trích chính F-001, hoặc F-001 trích
   871	  // H-001 trong khi H-001 trích lại F-001. Mọi id đều "tồn tại", tỉ lệ giải
   872	  // được báo 100%, và kết quả ĐẠT — trong khi KHÔNG có một mẩu bằng chứng nào
   873	  // từ tầng tất định đứng sau nó. Đó đúng là thứ mà cả tầng kiểm định này sinh
   874	  // ra để chặn: kết luận tự nuôi chính nó.
   875	  //
   876	  // Quy tắc: đi theo chuỗi trích dẫn nội bộ, phải chạm tới ÍT NHẤT một id của
   877	  // gói. Chu trình được phát hiện bằng tập đã thăm và tính là KHÔNG neo được.
   878	  // Đếm RIÊNG với `unresolvedEvidenceRefs`: một id không tồn tại là lỗi của
   879	  // THAM CHIẾU, còn không neo được là lỗi của MỤC. Gộp chung sẽ đếm đôi một id
   880	  // sai (vừa không tồn tại, vừa làm mục đó không neo được).
   881	  let ungroundedItems = 0
   882	  const packageIds = new Set(input.allowedEvidenceIds)
   883	  const internalRefs = new Map<string, string[]>()
   884	  for (const f of output.keyFindings) internalRefs.set(f.id, f.evidenceIds)
   885	  for (const h of output.hypotheses) internalRefs.set(h.id, h.supportingEvidenceIds)
   886	
   887	  /**
   888	   * Tính "neo được" bằng ĐIỂM BẤT ĐỘNG, không phải DFS có nhớ đệm.
   889	   *
   890	   * Bản DFS đầu tiên nhớ đệm kết quả tính ra khi tập `seen` đang KHÁC RỖNG. Kết
   891	   * quả đó phụ thuộc đường đi: một nút bị coi là "không neo được" chỉ vì đường
   892	   * đi hiện tại đã đi qua nút neo nó, rồi giá trị sai ấy được nhớ và dùng lại
   893	   * cho các phép kiểm sau. Nhớ đệm một kết quả phụ thuộc đường đi là không đúng.
   894	   *
   895	   * Điểm bất động không có vấn đề đó: xuất phát từ các mục trích thẳng bằng
   896	   * chứng của gói, rồi lan dần. Chu trình tự nhiên không bao giờ được đánh dấu
   897	   * vì không có gì neo chúng. Luôn dừng sau tối đa n vòng.
   898	   */
   899	  const grounded = new Set<string>()
   900	  for (let pass = 0; pass <= internalRefs.size; pass++) {
   901	    let changed = false
   902	    for (const [id, refs] of internalRefs) {
   903	      if (grounded.has(id)) continue
   904	      if (refs.some((r) => r !== id && (packageIds.has(r) || grounded.has(r)))) {
   905	        grounded.add(id)
   906	        changed = true
   907	      }
   908	    }
   909	    if (!changed) break
   910	  }
   911	  const isGrounded = (id: string): boolean => packageIds.has(id) || grounded.has(id)
   912	
   913	  const checkGrounding = (id: string, refs: string[], path: string, label: string): void => {
   914	    if (refs.length === 0) return // đã có quy tắc riêng cho "không bằng chứng"
   915	    if (refs.includes(id)) {
   916	      evidenceIssues.push({
   917	        rule: 'self_referential_evidence',
   918	        severity: 'BLOCKER',
   919	        message: `${label} tự trích chính nó (${id}) làm bằng chứng`,
   920	        path,
   921	      })
   922	      ungroundedItems++
   923	      return
   924	    }
   925	    if (!refs.some((r) => r !== id && isGrounded(r))) {
   926	      evidenceIssues.push({
   927	        rule: 'evidence_not_grounded',
   928	        severity: 'BLOCKER',
   929	        message: `${label} chỉ trích dẫn nội bộ, không neo về bằng chứng nào của gói`,
   930	        path,
   931	      })
   932	      ungroundedItems++
   933	    }
   934	  }
   935	
   936	  output.keyFindings.forEach((f, i) =>
   937	    checkGrounding(f.id, f.evidenceIds, `keyFindings[${i}].evidenceIds`, `keyFindings[${i}]`),
   938	  )
   939	  output.hypotheses.forEach((h, i) =>
   940	    checkGrounding(
   941	      h.id,
   942	      h.supportingEvidenceIds,
   943	      `hypotheses[${i}].supportingEvidenceIds`,
   944	      `hypotheses[${i}]`,
   945	    ),
   946	  )
   947	  output.recommendations.forEach((r, i) => {
   948	    if (r.evidenceIds.length === 0) return
   949	    if (!r.evidenceIds.some((x) => isGrounded(x))) {
   950	      evidenceIssues.push({
   951	        rule: 'evidence_not_grounded',
   952	        severity: 'BLOCKER',
   953	        message: `recommendations[${i}] chỉ trích dẫn nội bộ, không neo về bằng chứng nào của gói`,
   954	        path: `recommendations[${i}].evidenceIds`,
   955	      })
   956	      ungroundedItems++
   957	    }
   958	  })
   959	
