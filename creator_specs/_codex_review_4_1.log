592-   592	    // thành "(thiếu)" — khác mọi canon thật, nên nó BÁO TRÔI DẠT (fail-closed)
593-   593	    // thay vì ném ngoại lệ hay im lặng cho qua.
594-   594	    const canonOf = (x: { sourceRef?: { section?: string; itemId?: string; field?: string } }) =>
595-   595	      x.sourceRef ? `${x.sourceRef.section}|${x.sourceRef.itemId}|${x.sourceRef.field}` : '(thiếu sourceRef)'
