   243	const PERF_OBJECT =
   244	  '(?:lượt xem|view\\w*|retention|giữ chân|tiếp cận|reach|đăng ký|subscriber\\w*|tương tác|engagement|hiệu suất|performance|thứ hạng|ranking|ctr|impressions?)'
