554-   554	  const repIds = repaired.map((c) => c.id)
555-   555	
556-   556	  const dupRoot = repIds.filter((id, i) => repIds.indexOf(id) !== i)
557-   557	  if (dupRoot.length > 0) drift.push(`claim id trùng sau khi sửa: ${[...new Set(dupRoot)].join(', ')}`)
558-   558	
559-   559	  const added = repIds.filter((id) => !rootIds.includes(id))
560-   560	  if (added.length > 0) drift.push(`claim MỚI xuất hiện sau khi sửa: ${added.join(', ')}`)
561-   561	  if (repaired.length !== root.length) {
562-   562	    drift.push(`số claim đổi: ${root.length} -> ${repaired.length}`)
563-   563	  }
564-   564	
565-   565	  const byId = new Map(repaired.map((c) => [c.id, c]))
566-   566	  for (const r of root) {
567-   567	    const c = byId.get(r.id)
568-   568	    if (!c) {
569-   569	      drift.push(`bỏ mất claim ${r.id}`)
570-   570	      continue
571-   571	    }
572-   572	    for (const k of [
573-   573	      'subjectMetric',
574-   574	      'relatedMetric',
575-   575	      'claimType',
576-   576	      'assertionStatus',
577-   577	      'judgement',
578-   578	    ] as const) {
579-   579	      if (r[k] !== c[k]) drift.push(`${r.id}.${k}: "${r[k]}" -> "${c[k]}"`)
580-   580	    }
581-   581	
582-   582	    // DANH TÍNH CHUẨN TẮC của ô nguồn: section | itemId | field.
583-   583	    //
584-   584	    // KHÔNG được đổi, kể cả khi ô mới có nội dung y hệt. Hai mục khác nhau có
585-   585	    // thể chứa cùng một câu; cho phép nhảy sang mục khác vì "văn bản giống" là
586-   586	    // cho phép đổi CHỦ SỞ HỮU của kết luận mà không ai thấy.
587-   587	    //
588-   588	    // Chỉ `ordinal` — dữ liệu vị trí suy ra — được phép đổi sau khi đảo thứ tự.
589-   589	    //
590-   590	    // Đọc PHÒNG THỦ: mốc có thể là dữ liệu đã lưu từ một lần chạy cũ, và một mốc
