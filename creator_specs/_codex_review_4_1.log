   164	 */
   165	/**
   166	 * Tách một ô văn bản thành các MỆNH ĐỀ.
   167	 *
   168	 * Dùng để đếm "một ô có mấy phát biểu về chỉ số nhạy cảm". Đây là HEURISTIC
   169	 * NGÔN NGỮ, không phải phân tích cú pháp — ranh giới này được ghi rõ ở
   170	 * creator_specs/PHASE4_TRUST_BOUNDARIES.md và không được trình bày là tất định.
   171	 */
   172	export function clausesOf(text: string): string[] {
   173	  return text
   174	    // KHÔNG bọc liên từ trong `\b...\b`: "và" kết thúc bằng "à" (không thuộc
   175	    // `\w`) nên `\bvà\b` là NHÁNH CHẾT với cờ `u` — không bao giờ khớp, không
   176	    // báo gì. `\s+` hai bên đã là biên, nên `\b` chỉ thêm rủi ro.
   177	    //
   178	    // "và" bị LOẠI khỏi danh sách một cách CÓ Ý THỨC, không phải bỏ sót.
   179	    //
   180	    // Trong tiếng Việt "và" nối DANH NGỮ cũng nhiều như nối mệnh đề, và bộ tách
   181	    // này không phân biệt được hai việc đó. Cho nó tách trên "và" thì câu
   182	    //   "Không thể đánh giá tiếp cận vì impressions và CTR có độ phủ 0%"
   183	    // — MỘT phát biểu, chủ ngữ ghép — bị đếm thành hai và U1 chặn oan. Đó đúng
   184	    // là kiểu câu hợp đồng MUỐN mô hình viết: nói thẳng dữ liệu nào đang thiếu.
   185	    // Phạt nó là dạy mô hình nói mơ hồ hơn.
   186	    //
   187	    // GIỚI HẠN CÒN LẠI, ghi rõ để không ai tưởng đã phủ kín: một ô chứa hai
   188	    // phán xét nối bằng "và" ("CTR thấp và impressions thấp") được U1 đếm là
   189	    // MỘT. Nó vẫn bị chặn bởi các quy tắc khác khi chỉ số có độ phủ 0
   190	    // (`asserted_claim_on_missing_metric`) và bởi `undeclared_metric_in_claim_text`
   191	    // khi chỉ số nhắc tới không nằm trong subject/related đã khai — nhưng KHÔNG
   192	    // bị U1 chặn. Đây là heuristic ngôn ngữ, không phải phép tách cú pháp; xem
   193	    // creator_specs/PHASE4_TRUST_BOUNDARIES.md.
   194	    .split(/[.!?;:\n]|,\s+|\s+(?:nhưng|còn)\s+/iu)
   195	    .map((x) => x.trim())
   196	    .filter(Boolean)
   197	}
