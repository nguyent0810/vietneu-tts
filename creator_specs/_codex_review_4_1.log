   140	 */
   141	const SENSITIVE_MENTION = new RegExp(
   142	  `(?:${SENSITIVE_METRICS.map((m) => METRIC_ALIASES[m]!.source).join('|')})`,
   143	  'iu',
   144	)
   145	
   146	function mentionedSensitiveMetrics(text: string): Set<string> {
   147	  const out = new Set<string>()
   148	  for (const m of SENSITIVE_METRICS) {
   149	    if (METRIC_ALIASES[m]!.test(text)) out.add(m)
   150	  }
   151	  return out
   152	}
