   339	
   340	type ZodNode = { _def?: Record<string, unknown> }
   341	
   342	function unwrapNode(node: unknown): ZodNode {
   343	  let n = node as ZodNode
   344	  while (n?._def && ['ZodDefault', 'ZodOptional', 'ZodNullable'].includes(n._def.typeName as string)) {
   345	    n = n._def.innerType as ZodNode
   346	  }
   347	  return n
   348	}
   349	
   350	function shapeOf(node: ZodNode): Record<string, unknown> | null {
   351	  if ((node?._def?.typeName as string) !== 'ZodObject') return null
   352	  return (node._def!.shape as () => Record<string, unknown>)()
   353	}
   354	
   355	/**
   356	 * Một trường có phải BỀ MẶT VĂN BẢN TỰ DO không.
   357	 *
   358	 * Quy tắc, không phải danh sách: chuỗi (hoặc mảng chuỗi) KHÔNG phải định danh.
   359	 * Định danh nhận ra theo hai dấu hiệu độc lập —
   360	 *   - có ràng buộc regex (`id`, `hypothesisId`): dạng cố định, không phải văn xuôi;
   361	 *   - tên kết thúc bằng `Id`/`Ids` (`targetId`, `evidenceIds`, …).
   362	 *
   363	 * ENUM bị loại vì là ZodEnum, không phải ZodString — dù lúc chạy giá trị của nó
   364	 * VẪN là chuỗi. Đây là lý do phép lọc phải hỏi SCHEMA chứ không hỏi `typeof`:
   365	 * một ref trỏ vào `keyFindings[0].confidence` đọc ra "MEDIUM" hoàn toàn trót lọt
   366	 * nếu chỉ kiểm kiểu lúc chạy.
   367	 *
   368	 * Nhờ là QUY TẮC, một trường văn bản mới thêm vào schema tự động lọt vào danh
   369	 * sách này, thay vì phải nhớ đăng ký ở một chỗ thứ hai.
   370	 */
   371	function proseFieldsOf(objectNode: ZodNode): Array<{ name: string; array: boolean }> {
   372	  const shape = shapeOf(objectNode)
   373	  if (!shape) return []
   374	  const out: Array<{ name: string; array: boolean }> = []
   375	  for (const [name, raw] of Object.entries(shape)) {
   376	    if (/Ids?$/u.test(name)) continue
   377	    const node = unwrapNode(raw)
   378	    const typeName = node?._def?.typeName as string | undefined
   379	    if (typeName === 'ZodString') {
   380	      const checks = (node._def!.checks as Array<{ kind: string }>) ?? []
   381	      if (checks.some((c) => c.kind === 'regex')) continue
   382	      out.push({ name, array: false })
   383	      continue
   384	    }
   385	    if (typeName === 'ZodArray') {
   386	      const el = unwrapNode(node._def!.type)
   387	      if ((el?._def?.typeName as string) === 'ZodString') out.push({ name, array: true })
   388	    }
   389	  }
   390	  return out
   391	}
   392	
   393	/** Ví dụ id suy ra thẳng từ regex của schema: `^F-\d{3}$` -> `F-001`. */
   394	function idExampleFrom(objectNode: ZodNode): string {
   395	  const shape = shapeOf(objectNode)
   396	  const idNode = unwrapNode(shape?.['id'])
   397	  if ((idNode?._def?.typeName as string) !== 'ZodString') return ''
   398	  const checks = (idNode._def!.checks as Array<{ kind: string; regex?: RegExp }>) ?? []
   399	  const re = checks.find((c) => c.kind === 'regex')?.regex
   400	  if (!re) return ''
   401	  return re.source
   402	    .replace(/^\^/u, '')
   403	    .replace(/\$$/u, '')
   404	    .replace(/\\d\{(\d+)\}/u, (_m, n: string) => String(1).padStart(Number(n), '0'))
   405	}
