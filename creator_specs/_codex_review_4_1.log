   101	 *
   102	 * Câu về impressions/CTR không phải viết cho đẹp: cả ba kênh đều có độ phủ 0%
   103	 * cho hai chỉ số đó, nên mọi kết luận về hiệu quả thumbnail/tiêu đề đều sẽ là
   104	 * bịa. Bộ kiểm định cũng chặn độc lập ở phía sau, nhưng nói rõ ngay trong
   105	 * prompt sẽ rẻ hơn nhiều so với để mô hình viết ra rồi mới từ chối.
   106	 */
   107	function hardConstraints(pkg: AnalysisPackage): string {
   108	  const ctrCoverage = pkg.dataCoverage.metricCoverage['impressions'] ?? 0
   109	  const ctrLine =
   110	    ctrCoverage === 0
   111	      ? 'Impressions và click-through rate KHÔNG CÓ trong phân tích này (độ phủ 0%). ' +
   112	        'KHÔNG được kết luận gì về hiệu quả thumbnail, khả năng hút click của tiêu đề, ' +
   113	        'độ tiếp cận của "packaging", hay tỉ lệ chuyển đổi từ hiển thị. Chủ đề packaging ' +
   114	        'CHỈ được xuất hiện dưới dạng giả thuyết CHƯA KIỂM CHỨNG, và phải nói rõ bằng ' +
   115	        'chứng nào đang thiếu.'
   116	      : `Độ phủ impressions là ${Math.round(ctrCoverage * 100)}%; mọi kết luận về tiếp cận phải nêu rõ mức phủ đó.`
   117	
   118	  return [
   119	    ctrLine,
   120	    'Tương quan KHÔNG phải nhân quả.',
   121	    'Thiếu dữ liệu KHÔNG phải bằng 0. Feature có `missingReason` là KHÔNG BIẾT, không phải "kém".',
   122	    'Video chưa đủ chín KHÔNG được đánh giá như video đã chín.',
