602-   602	    //
603-   603	    // Bản trước chỉ chặn việc BỚT, cho phép THÊM. Nhưng thêm bằng chứng biến một
604-   604	    // khẳng định vốn không có căn cứ thành một phân tích KHÁC — mà "thiếu bằng
605-   605	    // chứng" vốn là thất bại NỘI DUNG, không được retry ngay từ đầu. Vậy một
606-   606	    // lần sửa KỸ THUẬT không bao giờ có lý do chính đáng để thêm bằng chứng.
607-   607	    //
608-   608	    // Thiếu bằng chứng => phải chạy lại một execution GỐC mới.
609-   609	    // SỐ trong VĂN BẢN ĐƯỢC TRỎ TỚI là dữ liệu, không phải cách diễn đạt.
610-   610	    //
611-   611	    // Sửa lỗi kỹ thuật được phép viết lại câu, nhưng KHÔNG được đổi con số:
612-   612	    // "views_d7 là 100" -> "views_d7 là 1.000" giữ nguyên mọi trường được so,
613-   613	    // nên lọt hoàn toàn — trong khi đó là bịa lại dữ liệu.
614-   614	    const rootNums = numericTokens(rootText.get(r.id) ?? '')
615-   615	    const repNums = numericTokens(repairedText.get(c.id) ?? '')
616-   616	    if (rootNums.join(',') !== repNums.join(',')) {
617-   617	      drift.push(`${r.id} đổi SỐ trong text: [${rootNums.join(', ')}] -> [${repNums.join(', ')}]`)
618-   618	    }
619-   619	
620-   620	    // Nội dung ô được trỏ tới KHÔNG được đổi.
621-   621	    const rt = rootText.get(r.id)
622-   622	    const ct = repairedText.get(c.id)
623-   623	    if (rt !== undefined && ct !== undefined && rt.trim() !== ct.trim()) {
624-   624	      drift.push(`${r.id}: văn bản ô nguồn đã đổi`)
625-   625	    }
626-   626	
627-   627	    const lost = r.evidenceIds.filter((e) => !c.evidenceIds.includes(e))
628-   628	    const gained = c.evidenceIds.filter((e) => !r.evidenceIds.includes(e))
629-   629	    if (lost.length > 0) drift.push(`${r.id} mất bằng chứng: ${lost.join(', ')}`)
630-   630	    if (gained.length > 0) drift.push(`${r.id} THÊM bằng chứng: ${gained.join(', ')}`)
631-   631	  }
632-   632	  return drift
