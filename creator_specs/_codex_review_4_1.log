   139	/**
   140	 * Sinh danh sách RÀNG BUỘC thẳng từ Zod schema.
   141	 *
   142	 * Viết tay danh sách này là công thức để lệch: schema đổi, prompt không đổi, và
   143	 * mô hình bị từ chối vì một giới hạn chưa ai nói cho nó biết. Chính lỗi đó đã
   144	 * làm hỏng một lần thử ở lô 5 ("Array must contain at most 12 element(s)" —
   145	 * trần lồng nhau chưa từng xuất hiện trong prompt).
   146	 *
   147	 * Đọc trực tiếp từ `_def` nên không thể lệch: đổi schema là prompt đổi theo.
   148	 */
   149	function describeConstraints(node: unknown, path: string, out: string[]): void {
   150	  const def = (node as { _def?: Record<string, unknown> })?._def
   151	  if (!def) return
   152	  const name = def.typeName as string
   153	
   154	  if (name === 'ZodDefault' || name === 'ZodOptional' || name === 'ZodNullable') {
   155	    describeConstraints(def.innerType, path, out)
   156	    return
   157	  }
   158	  if (name === 'ZodObject') {
   159	    const shape = (def.shape as () => Record<string, unknown>)()
   160	    for (const [k, v] of Object.entries(shape)) {
   161	      describeConstraints(v, path ? `${path}.${k}` : k, out)
   162	    }
   163	    return
   164	  }
   165	  if (name === 'ZodArray') {
   166	    const min = (def.minLength as { value: number } | null)?.value
   167	    const max = (def.maxLength as { value: number } | null)?.value
   168	    if (min !== undefined || max !== undefined) {
   169	      const lo = min ?? 0
   170	      const hi = max === undefined ? 'không giới hạn' : String(max)
   171	      out.push(`  ${path}: mảng ${lo}..${hi} phần tử`)
   172	    }
   173	    describeConstraints(def.type, `${path}[]`, out)
   174	    return
   175	  }
   176	  if (name === 'ZodString') {
   177	    const checks = (def.checks as Array<{ kind: string; value?: number; regex?: RegExp }>) ?? []
   178	    const min = checks.find((c) => c.kind === 'min')?.value
   179	    const max = checks.find((c) => c.kind === 'max')?.value
   180	    // REGEX cũng phải nêu. Bỏ qua nó là để lại đúng khoảng trống đã gây hỏng
   181	    // hai lô: một ràng buộc có hiệu lực mà mô hình chưa từng được cho biết.
   182	    const re = checks.find((c) => c.kind === 'regex')?.regex
   183	    if (re) {
   184	      out.push(`  ${path}: phải khớp ${String(re)}`)
   185	    } else if (min !== undefined || max !== undefined) {
   186	      out.push(`  ${path}: chuỗi ${min ?? 0}..${max ?? '∞'} ký tự`)
   187	    }
   188	    return
   189	  }
   190	  if (name === 'ZodNumber') {
   191	    const checks = (def.checks as Array<{ kind: string; value: number }>) ?? []
   192	    const min = checks.find((c) => c.kind === 'min')?.value
   193	    const max = checks.find((c) => c.kind === 'max')?.value
   194	    const isInt = checks.some((c) => c.kind === 'int')
   195	    out.push(`  ${path}: ${isInt ? 'số nguyên' : 'số'} ${min ?? '-∞'}..${max ?? '∞'}`)
   196	  }
   197	}
   198	
   199	/** Toàn bộ ràng buộc độ dài / số phần tử / khoảng số của schema output. */
   200	export function schemaConstraintLines(): string[] {
   201	  const out: string[] = []
   202	  describeConstraints(cursorOutputSchema, '', out)
   203	  return out
   204	}
   205	
   206	/** Bảng `section` / `itemId` / `field` hợp lệ để dán thẳng vào prompt. */
   207	export function sourceRefLines(): string[] {
   208	  return sourceRefSections().map((s) => {
   209	    const itemId = s.kind === 'ITEM' ? `"${s.itemIdExample}"` : '"" (rỗng)'
   210	    const fields = s.fields
   211	      .map((f) => (s.kind === 'INDEXED' ? `${f.name}@N` : f.name) + (f.array ? '[]' : ''))
   212	      .join(', ')
   213	    return `  ${s.section} — itemId ${itemId} — field: ${fields}`
   214	  })
   215	}
   216	
   217	function section(title: string, body: string): string {
   218	  return `\n## ${title}\n${body.trim()}\n`
   219	}
   220	
   221	/** JSON gọn, khoá đã sắp — giữ prompt tất định. */
   222	function compactJson(value: unknown): string {
   223	  return JSON.stringify(sortKeys(value), null, 1)
   224	}
   225	
   226	function sortKeys(value: unknown): unknown {
   227	  if (Array.isArray(value)) return value.map(sortKeys)
   228	  if (value !== null && typeof value === 'object') {
   229	    return Object.fromEntries(
   230	      Object.entries(value as Record<string, unknown>)
   231	        .filter(([, v]) => v !== undefined)
   232	        .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
   233	        .map(([k, v]) => [k, sortKeys(v)]),
   234	    )
   235	  }
   236	  return value
   237	}
   238	
   239	/**
   240	 * ID bằng chứng ổn định mà output được phép tham chiếu.
   241	 *
   242	 * Bằng chứng phải ĐỊNH DANH ĐƯỢC thì mới kiểm được: nếu mô hình chỉ viết "theo
   243	 * dữ liệu" thì không có cách nào máy móc để xác minh. Mỗi quan sát, bất thường
   244	 * và video xếp hạng vì thế đều nhận một id ổn định.
   245	 */
   246	export function evidenceIdsFor(pkg: AnalysisPackage): {
   247	  ids: string[]
   248	  observationIds: Map<number, string>
   249	  anomalyIds: Map<number, string>
   250	  videoIds: string[]
   251	  cohortKeys: string[]
   252	} {
   253	  const ids: string[] = []
   254	  const observationIds = new Map<number, string>()
   255	  const anomalyIds = new Map<number, string>()
   256	
   257	  pkg.observations.forEach((_, i) => {
   258	    const id = `OBS-${String(i + 1).padStart(3, '0')}`
   259	    observationIds.set(i, id)
   260	    ids.push(id)
   261	  })
   262	  pkg.hypothesisCandidates.forEach((_, i) => {
   263	    ids.push(`HYP-${String(i + 1).padStart(3, '0')}`)
   264	  })
   265	  pkg.anomalies.forEach((_, i) => {
   266	    const id = `ANOM-${String(i + 1).padStart(3, '0')}`
   267	    anomalyIds.set(i, id)
   268	    ids.push(id)
   269	  })
   270	  // Video hợp lệ = danh sách xếp hạng ∪ video được NHẮC TỚI trong các câu quan
   271	  // sát. `rankedVideos` bị cắt ở top-20, nhưng câu quan sát vẫn nêu tên những
   272	  // video ngoài top đó — chúng vẫn thuộc kênh này (gói vốn chỉ chứa một kênh),
   273	  // nên chặn chúng là chặn nhầm. Ở lần chạy thật, Cursor đã đề xuất rà soát một
   274	  // video như vậy và bị từ chối oan.
   275	  const videoIdSet = new Set(pkg.rankedVideos.map((v) => String(v.youtubeVideoId)))
   276	  const YT_IN_TEXT = /\bVideo ([A-Za-z0-9_-]{11})\b/g
   277	  for (const o of [...pkg.observations, ...pkg.hypothesisCandidates]) {
   278	    for (const m of o.statement.matchAll(YT_IN_TEXT)) videoIdSet.add(m[1]!)
   279	  }
   280	  for (const a of pkg.anomalies) {
   281	    const id = (a as { youtubeVideoId?: unknown }).youtubeVideoId
   282	    if (typeof id === 'string') videoIdSet.add(id)
   283	  }
   284	  const videoIds = [...videoIdSet].sort()
   285	  const cohortKeys = pkg.cohortComparisons.map((c) => String((c as { key?: unknown }).key ?? ''))
   286	  for (const v of videoIds) ids.push(`VIDEO-${v}`)
   287	  pkg.baselines.forEach((b) => ids.push(`BASE-${b.key}`))
   288	  pkg.cohortComparisons.forEach((c, i) => ids.push(`COHORT-${String(i + 1).padStart(3, '0')}`))
   289	
   290	  return { ids, observationIds, anomalyIds, videoIds, cohortKeys }
   291	}
   292	
