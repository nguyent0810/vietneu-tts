   139	/**
   140	 * Sinh danh sách RÀNG BUỘC thẳng từ Zod schema.
   141	 *
   142	 * Viết tay danh sách này là công thức để lệch: schema đổi, prompt không đổi, và
   143	 * mô hình bị từ chối vì một giới hạn chưa ai nói cho nó biết. Chính lỗi đó đã
   144	 * làm hỏng một lần thử ở lô 5 ("Array must contain at most 12 element(s)" —
   145	 * trần lồng nhau chưa từng xuất hiện trong prompt).
   146	 *
   147	 * Đọc trực tiếp từ `_def` nên không thể lệch: đổi schema là prompt đổi theo.
   148	 */
   149	function describeConstraints(node: unknown, path: string, out: string[]): void {
   150	  const def = (node as { _def?: Record<string, unknown> })?._def
   151	  if (!def) return
   152	  const name = def.typeName as string
   153	
   154	  if (name === 'ZodDefault' || name === 'ZodOptional' || name === 'ZodNullable') {
   155	    describeConstraints(def.innerType, path, out)
   156	    return
   157	  }
   158	  if (name === 'ZodObject') {
   159	    const shape = (def.shape as () => Record<string, unknown>)()
   160	    for (const [k, v] of Object.entries(shape)) {
   161	      describeConstraints(v, path ? `${path}.${k}` : k, out)
   162	    }
   163	    return
   164	  }
   165	  if (name === 'ZodArray') {
   166	    const min = (def.minLength as { value: number } | null)?.value
   167	    const max = (def.maxLength as { value: number } | null)?.value
   168	    if (min !== undefined || max !== undefined) {
   169	      const lo = min ?? 0
   170	      const hi = max === undefined ? 'không giới hạn' : String(max)
   171	      out.push(`  ${path}: mảng ${lo}..${hi} phần tử`)
   172	    }
   173	    describeConstraints(def.type, `${path}[]`, out)
   174	    return
   175	  }
   176	  if (name === 'ZodString') {
   177	    const checks = (def.checks as Array<{ kind: string; value?: number; regex?: RegExp }>) ?? []
   178	    const min = checks.find((c) => c.kind === 'min')?.value
   179	    const max = checks.find((c) => c.kind === 'max')?.value
   180	    // REGEX cũng phải nêu. Bỏ qua nó là để lại đúng khoảng trống đã gây hỏng
   181	    // hai lô: một ràng buộc có hiệu lực mà mô hình chưa từng được cho biết.
