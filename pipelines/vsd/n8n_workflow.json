{
  "name": "VSD automatic pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "vsd-schedule",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "cd ~/vietneu-tts && ~/vietneu-tts/.venv/bin/python -m pipelines.vsd next-render",
        "executeOnce": false
      },
      "id": "vsd-render",
      "name": "Render next",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "command": "cd ~/vietneu-tts && ~/vietneu-tts/.venv/bin/python -m pipelines.vsd next-upload",
        "executeOnce": false
      },
      "id": "vsd-upload",
      "name": "Upload next",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "command": "cd ~/vietneu-tts && ~/vietneu-tts/.venv/bin/python -m pipelines.vsd status",
        "executeOnce": false
      },
      "id": "vsd-status",
      "name": "Pipeline status",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {},
      "id": "vsd-error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "command": "cd ~/vietneu-tts && ~/vietneu-tts/.venv/bin/python -c 'import json,datetime,pathlib; p=pathlib.Path(\"pipelines/vsd/logs/n8n_errors.jsonl\"); p.parent.mkdir(parents=True,exist_ok=True); p.open(\"a\").write(json.dumps({\"ts\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\"workflow_error\":True})+\"\\n\")'"
      },
      "id": "vsd-error-log",
      "name": "Log workflow error",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        260
      ]
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Render next",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render next": {
      "main": [
        [
          {
            "node": "Upload next",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload next": {
      "main": [
        [
          {
            "node": "Pipeline status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log workflow error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "vsd-pipeline-116b"
}
