# Copy file này thành .youtube_oauth_clients.env rồi điền giá trị thật.
# .youtube_oauth_clients.env đã nằm trong .gitignore — KHÔNG commit.
#
# Client ID/Secret của OAuth Client (loại "Desktop app") lấy tại
# https://console.cloud.google.com/apis/credentials — bật "YouTube Data API v3"
# + "YouTube Analytics API" cho project đó. Có thể dùng chung 1 OAuth Client
# cho cả 3 kênh; refresh_token của từng kênh vẫn tách riêng.
#
# File này CHỈ chứa client_id/client_secret (định danh app). refresh_token thật
# của từng kênh nằm ở .youtube_channels/{label}.json, sinh ra SAU khi chạy
# bootstrap — không phải ở đây. Cả 2 đường dẫn đều đã gitignore và được
# scripts/secret_scan.py chặn cứng.
#
# Điền xong, bootstrap từng kênh (1 lần/kênh, cần trình duyệt):
#   uv run python youtube_auth.py bootstrap \
#     --client-id <CLIENT_ID> --client-secret <CLIENT_SECRET> \
#     --channel-label phong_thuy
# (tương tự cho phat_giao, hinh_su)

# --- Kênh: Phong Thuỷ ---
PHONG_THUY_CLIENT_ID=
PHONG_THUY_CLIENT_SECRET=

# --- Kênh: Phật Giáo ---
PHAT_GIAO_CLIENT_ID=
PHAT_GIAO_CLIENT_SECRET=

# --- Kênh: Hình Sự ---
HINH_SU_CLIENT_ID=
HINH_SU_CLIENT_SECRET=
