def norm(w: str) -> str:
    return re.sub(r"[^\w]", "", unicodedata.normalize("NFC", w.lower()))


# ---------------- báº£ng Ä‘á»c (spec "say", nhÆ° build_long.spoken) ----------------
def _core(tok: str) -> tuple[str, str, str]:
    m = re.match(r"^([\"â€œ(]*)(.*?)([\"â€)â€¦,.;:?!]*)$", tok)
    return m.group(1), m.group(2), m.group(3)


def _say_tables(say: dict | None) -> tuple[dict, dict]:
    """spec "say": {"seoul": "XÆ¡-un"} khá»›p khÃ´ng phÃ¢n biá»‡t hoa/thÆ°á»ng; {"=ELIZA": "ÃŠ-li-dÆ¡"} khá»›p ÄÃšNG hoa/thÆ°á»ng
    (trÃ¡nh "di cÆ°" thÃ nh "Äi cÆ°" khi chá»‰ muá»‘n Ä‘á»•i tÃªn riÃªng "Di")."""
    exact, low = {}, {}
    for k, v in (say or {}).items():
        k = unicodedata.normalize("NFC", k)
        if k.startswith("="):
            exact[k[1:]] = v
        else:
            low[k.lower()] = v
    return exact, low


def spoken_word(tok: str, say: dict | None) -> str:
    """CÃ¡ch Ä‘á»c má»™t chá»¯ (giá»¯ dáº¥u cÃ¢u/ngoáº·c quanh chá»¯). KhÃ´ng cÃ³ trong báº£ng -> tráº£ nguyÃªn chá»¯."""
    if not say:
        return tok
    exact, low = _say_tables(say)
    a, c, z = _core(tok)
    c0 = unicodedata.normalize("NFC", c)
    r = exact.get(c0, low.get(c0.lower()))
    return tok if r is None else a + r + z


def spoken(text: str, say: dict | None) -> str:
    """CÃ¢u Ä‘Æ°a vÃ o TTS. Phá»¥ Ä‘á»/chá»¯ trÃªn mÃ n hÃ¬nh váº«n dÃ¹ng cÃ¢u gá»‘c. CÃ¢u khÃ´ng cÃ³ chá»¯ nÃ o trong báº£ng -> tráº£
    NGUYÃŠN cÃ¢u (ká»ƒ cáº£ khoáº£ng tráº¯ng) Ä‘á»ƒ cache giá»ng cÅ© váº«n khá»›p."""
    if not say:
        return text
    toks = text.split()
    out = [spoken_word(x, say) for x in toks]
    return text if out == toks else " ".join(out)


def _has_say(tok: str, say: dict | None) -> bool:
    """`say` cÃ³ má»™t khoÃ¡ thá»±c sá»± khá»›p chá»¯ TTS nÃ y (ká»ƒ cáº£ khoÃ¡ `=ABC`)."""
    exact, low = _say_tables(say)
    _, core, _ = _core(tok)
    return core in exact or core.lower() in low


def spec_preflight_errors(slug: str, spec: dict) -> list[str]:
    """CÃ¡c cá»•ng tÄ©nh pháº£i qua trÆ°á»›c khi gá»i TTS/render.

    HÃ m nÃ y dÃ¹ng chung cho `build()` vÃ  `--preflight`; khÃ´ng tá»± Ä‘áº·t láº¡i ngÆ°á»¡ng
    cá»§a build, mix hay BUD.
    """
    lines_txt = spec["lines"]
    nw = sum(len(line.split()) for line in lines_txt)
    contem = spec.get("profile") == "chiem-nghiem"
    bangtra = spec.get("profile") == "bang-tra"
    out = []
    if not (20 if bangtra else 55) <= nw <= (400 if contem else 135):
        out.append(f"{nw} tá»« â€” ngoÃ i {20 if bangtra else 55}-{400 if contem else 135}")
    if spec.get("rules") == 2 and lines_txt[-1].rstrip().endswith("?"):
        out.append(f"Short rules-2 khÃ´ng káº¿t báº±ng cÃ¢u há»i: {lines_txt[-1]!r}")
    if spec.get("theme") in ("mim", "ck"):
        shown = json.dumps(spec.get("scenes", []), ensure_ascii=False)
        tilde = re.findall(r"~\s*\d[\d.,]*", shown)
        tilde += [f"{scene.get('prefix')}{scene.get('to')}" for scene in spec.get("scenes", [])
                  if scene.get("type") == "counter" and "~" in str(scene.get("prefix", ""))]
        if tilde:
            out.append(f"dáº¥u ~ trÆ°á»›c sá»‘ dá»… Ä‘á»c thÃ nh dáº¥u trá»«: {tilde} -- dÃ¹ng â‰ˆ")
    # TTS nháº­n tá»«ng token, vÃ¬ váº­y má»™t khoÃ¡ nhiá»u chá»¯ nhÆ° "TRM Labs" khÃ´ng thay
    # Ä‘Æ°á»£c cÃ¡ch Ä‘á»c cá»§a token "TRM". Chá»‰ xÃ©t kÃ½ hiá»‡u/viáº¿t táº¯t, khÃ´ng báº¯t tÃªn riÃªng.
    abbrev = re.compile(r"\b(?:[A-Z]{2,}|[A-Z]+\d+|[a-z]+[A-Z][A-Za-z]*)\b")
    for i, line in enumerate(lines_txt):
        for tok in abbrev.findall(line):
            if not _has_say(tok, spec.get("say")):
                out.append(f"cÃ¢u {i}: kÃ½ hiá»‡u/viáº¿t táº¯t {tok!r} chÆ°a cÃ³ say")
    return out


def estimated_word_lines(lines_txt: list[str], say: dict | None = None) -> tuple[list[dict], float]:
    """Má»‘c táº¡m cho preflight: 3,3 tá»«/giÃ¢y, khÃ´ng cáº§n audio hay máº¡ng."""
    cur, lines = 0.0, []
    for text in lines_txt:
        toks = text.split()
        step = 1 / 3.3
        words = [{"w": tok, "t": round(cur + j * step, 3), "d": round(step, 3)} for j, tok in enumerate(toks)]
        end = round(cur + len(toks) * step, 3)
        lines.append({"text": text, "start": round(cur, 3), "end": end, "words": words})
        cur = end
    return lines, round(cur, 3)


# ---------------- giá»ng Ä‘á»c ----------------
def _old_takes(wav: Path, tjson: Path, voice: str) -> dict:
    """{cÃ¢u Ä‘á»c: audio} láº¥y láº¡i tá»« voice.wav cÅ© cÃ¹ng giá»ng -- Ä‘á»•i báº£ng "say" chá»‰ Ä‘á»c láº¡i cÃ¢u cÃ³ cÃ¡ch Ä‘á»c Ä‘á»•i."""
    if not (tjson.exists() and wav.exists()):
        return {}
    try:
        import soundfile as sf
        t = json.loads(tjson.read_text(encoding="utf-8"))
        if t.get("voice", VOICE) != voice:
            return {}
        a, sr = sf.read(str(wav), dtype="float32")
        if sr != t.get("sample_rate", sr) or getattr(a, "ndim", 1) != 1:
            return {}
        return {s.get("say", s["text"]): a[int(round(s["start"] * sr)):int(round(s["end"] * sr))] for s in t["segments"]}
    except Exception:
        return {}


def speak(lines: list[str], wav: Path, tjson: Path, voice: str = VOICE, gap: float = 0.0, say: dict | None = None,
          tts: dict | None = None) -> dict:
    """Äá»c tá»«ng cÃ¢u, ghÃ©p wav + má»‘c cÃ¢u. Cache theo Cáº¢ lá»i láº«n giá»ng (Grok: Ä‘á»•i giá»ng mÃ 
    lá»i giá»¯ nguyÃªn thÃ¬ trÆ°á»›c Ä‘Ã¢y váº«n tráº£ wav giá»ng cÅ©). timing.json cÅ© khÃ´ng ghi giá»ng
    lÃ  cá»§a VOICE máº·c Ä‘á»‹nh (Anh KhÃ´i) -- cache CL cÅ© váº«n dÃ¹ng Ä‘Æ°á»£c.
    gap: giÃ¢y láº·ng chÃ¨n SAU má»—i cÃ¢u (trá»« cÃ¢u cuá»‘i) -- theme "ck" (giá»ng nhanh, kÃªnh 'ngÆ°á»i báº¡n' cáº§n chá»— thá»Ÿ).
    0 = nhÆ° cÅ©; timing.json chá»‰ ghi "gap" khi khÃ¡c 0, nÃªn cache cÅ© khÃ´ng Ä‘á»•i.
    say: báº£ng Ä‘á»c cá»§a spec (xem spoken()). TTS Ä‘á»c cÃ¢u Ä‘Ã£ thay; segment váº«n ghi "text" = cÃ¢u Gá»C (phá»¥ Ä‘á», má»‘c chá»¯)
    vÃ  chá»‰ thÃªm "say" khi cÃ¡ch Ä‘á»c khÃ¡c -- spec khÃ´ng cÃ³ "say" giá»¯ nguyÃªn timing.json/cache. Lá»¡ cache thÃ¬ cÃ¢u
    nÃ o cÃ³ cÃ¡ch Ä‘á»c (vÃ  giá»ng) y nhÆ° báº£n cÅ© Ä‘Æ°á»£c cáº¯t láº¡i tá»« voice.wav cÅ©, chá»‰ cÃ¢u Ä‘á»•i cÃ¡ch Ä‘á»c má»›i Ä‘á»c láº¡i."""
    global _engine
    spk = [spoken(ln, say) for ln in lines]
    if tjson.exists() and wav.exists():
        t = json.loads(tjson.read_text(encoding="utf-8"))
        if ([s["text"] for s in t["segments"]] == lines and [s.get("say", s["text"]) for s in t["segments"]] == spk
                and t.get("voice", VOICE) == voice and t.get("gap", 0.0) == gap and t.get("tts") == (tts or None)):
            return t
    import numpy as np
    import soundfile as sf
    from factory import integrity, speak as SP
    for sp in spk:                        # cáº£ há»“ sÆ¡, trÆ°á»›c khi Ä‘á»c cÃ¢u nÃ o (Ä‘Ãºng chuá»—i sáº¯p Ä‘Æ°a vÃ o TTS)
        integrity.require_speakable(sp)
    # tts (spec "tts", Short kiá»ƒu má»›i 12/10/2026): {"temperature": .., "pauses": {"<chá»‰ sá»‘ cÃ¢u>": giÃ¢y nghá»‰ SAU cÃ¢u Ä‘Ã³}} --
