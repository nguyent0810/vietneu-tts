import json, pathlib
P=pathlib.Path('data/analytics'); out=pathlib.Path('docs/pm')
patterns={
'MIM':([('Rủi ro gần gũi → cách ứng phó','[Công nghệ gây hại cho bạn]: [biện pháp cụ thể]',[0]),('Câu hỏi hiện tại → tiền lệ','[AI ảnh hưởng đời sống]? [Tiền lệ lịch sử]',[1]),('Sự cố cụ thể → câu hỏi cơ chế','[Nhân vật làm việc sai vì công nghệ]: Vì sao [cơ chế]?',[2]),('Công nghệ quen thuộc → câu hỏi cơ chế','[Tên công nghệ]: Vì sao [hành vi bất ngờ]?',[3]),('Cuộc đấu → chi tiết quyết định','[Số trận / bước ngoặt]: [đối thủ] và [chi tiết]',[4])],[('Chi tiết quyết định','[Nước đi / sự kiện cụ thể]: [kết quả bất ngờ]',[0,3]),('Vật quen thuộc → nghịch lý','[Công nghệ] [đặc tính bất ngờ]: vì sao?',[1]),('Mốc năm → phát minh / dự đoán','Năm [năm], [nhân vật / máy] [hành động cụ thể]',[2,5,8])]),
'CK':([('Hai lựa chọn × thời gian','[Khoản tiền A] hay [khoản tiền B]: [mốc] ai khá hơn?',[0]),('Biến cố có số → câu hỏi','[Biến cố có số]: Vì sao [hệ quả]?',[1]),('Hành vi thị trường → kiểm tra dữ liệu','[Hành vi] có phải [đỉnh]? [Số đợt / kỳ] bằng dữ liệu',[2]),('Khoản nợ → thời gian trả','[Loại nợ]: [hành vi trả] thì bao giờ hết? [số tiền]',[3]),('Khoản đều × thời gian → kết quả','Mỗi tháng [tiền] suốt [năm]: [kết quả và giới hạn]',[4])],[('Giá trị danh nghĩa → sức mua','[Khoản tiền] của [mốc] không bằng hôm nay: [cơ chế]',[0,2]),('Quy định → con số','[Chính sách]: từ [ngày] [hạn mức]',[1]),('Khoản tiền / thời gian → kết quả','[Tiền, thời gian] → [kết quả / câu hỏi]',[3,5,7])])}
for c in ['MIM','CK']:
 p=P/c/'183'; vs=json.loads((p/'videos.json').read_text(encoding='utf-8')); videos={v['id']:v for v in vs if v['privacy']=='public'}; rows={r['video']:r for r in json.loads((p/'byvideo_d28.json').read_text(encoding='utf-8'))['rows']}; sources=json.loads((p/'video_x_source.json').read_text(encoding='utf-8'))
 long=[v for v in videos.values() if 'M' in v['duration'] or 'H' in v['duration']]; short=[v for v in videos.values() if v not in long]; long.sort(key=lambda v:rows.get(v['id'],{}).get('estimatedMinutesWatched',0),reverse=True); short.sort(key=lambda v:rows.get(v['id'],{}).get('views',0),reverse=True)
 def title(v): return v['title'].replace('?????','…').replace('|','\\\\|')
 def fmt(v):
  r=rows.get(v['id']);
  if not r: return f\"| {title(v)} | {len(v['title'])} | — | — | — | — | Chưa có dữ liệu kỳ |\"
  sr=sources.get(v['id'],{}).get('d28',{}); ss=sorted(sr.get('rows',[]),key=lambda x:x['estimatedMinutesWatched'],reverse=True)[:2]; s='; '.join(f\"{x['insightTrafficSourceType']} {x['estimatedMinutesWatched']/60:.2f}h, {x['views']/r['views']*100:.1f}% lượt xem\" for x in ss) if sr.get('ok') else 'Không có dữ liệu'; a=r['averageViewDuration']; return f\"| {title(v)} | {len(v['title'])} | {r['views']} | {r['estimatedMinutesWatched']/60:.2f} | {a//60}:{a%60:02d} | {r['averageViewPercentage']:.1f}% | {s} |\"
 lines=[f'# Bộ khuôn tiêu đề {c}', '', '**Ngày phân tích:** 06/11/2026. **Kỳ 28 ngày:** 07/10–03/11/2026; dữ liệu Analytics kéo 06/11.', '', '> **Mức bằng chứng:** Lượt xem, phút xem, AVD, AVP và nguồn là **đo**; gợi ý khuôn và mọi giải thích hiệu quả là **suy luận** từ mẫu quan sát, không chứng minh tiêu đề gây ra kết quả. Mỗi khuôn ghi số video khác ID. Không có impressions, CTR hay thiết bị; không suy ra tỉ lệ nhấp, màn hình cắt chữ hoặc nguyên nhân thắng thua. Thử từng biến và đo lại sau 72 giờ, 7 ngày.', '', 'Gộp các bản ghi trùng ID; chỉ xét video công khai trong snapshot. Giờ = phút xem ước tính / 60; AVD và AVP lấy trực tiếp API, không suy từ giờ/lượt xem. Nguồn ghi tối đa hai nguồn có giờ xem cao nhất, kèm giờ và tỷ lệ trên lượt xem video; SUBSCRIBER = Browse/Home, RELATED_VIDEO = Đề xuất, EXT_URL = bên ngoài, YT_SEARCH = tìm kiếm. Các tổng có thể lệch do làm tròn hoặc dữ liệu API.', '']
 if c=='MIM': lines+=['**Lưu ý đổi tên:** 5 Long MIM được đổi tiêu đề ngày 06/11 theo PR #200, sau kỳ đo kết thúc 03/11; chưa có số sau đổi tên. Tiêu đề trong snapshot có thể khác tiêu đề đã phát sinh lượt xem; dữ liệu này không đo hiệu quả tên mới. Snapshot không xác định chắc danh sách năm video và tên trước/sau. Trong bảng, dấu hỏi lặp ở tên Watson được rút gọn thành dấu ba chấm để tránh nhầm lỗi mã hóa; số ký tự vẫn tính theo tên gốc.','']
 lines+=['## Long công khai: top 5 và bottom 5 theo giờ xem 28 ngày','','| Tiêu đề trong snapshot | Ký tự | Lượt xem | Giờ | AVD | AVP | Nguồn theo giờ; % lượt xem |','|---|---:|---:|---:|---:|---:|---|']
 for v in long[:5]+long[-5:]: lines.append(fmt(v))
 lines+=['','Bảng trên xếp giảm dần trong từng nhóm. Video cuối xuất bản 04/11, sau kỳ đo: không có dòng API, không được coi là thua; bốn dòng bottom còn lại có quan sát. Thứ hạng theo giờ không kiểm soát tuổi video, chủ đề hay nguồn truy cập.','','## Short: top 10 theo lượt xem 28 ngày','','Tỷ lệ ở lại = engagedViews / views, tính trên cùng kỳ; đây là tỷ số theo yêu cầu, không đồng nhất với AVP.','','| Tiêu đề | Ký tự | Lượt xem | Ở lại |','|---|---:|---:|---:|']
 for v in short[:10]:
  r=rows[v['id']]; e=r.get('engagedViews'); ratio=f\"{e/r['views']*100:.1f}%\" if e is not None and r['views'] else '—'; lines.append(f\"| {title(v)} | {len(v['title'])} | {r['views']} | {ratio} |\")
 for label,arr,kind in [('Long',patterns[c][0],'long'),('Short',patterns[c][1],'short')]:
  lines+=['',f'## Khuôn {label} để thử','']
  for name,structure,ixs in arr:
   samples=long if kind=='long' else short; parts=[]
   for i in ixs:
    v=samples[i]; r=rows[v['id']]; metric=f\"{r['estimatedMinutesWatched']/60:.2f} giờ, {r['views']} lượt xem\" if kind=='long' else f\"{r['views']} lượt xem, {r['engagedViews']/r['views']*100:.1f}% ở lại\"; parts.append(f\"“{title(v)}” ({len(v['title'])} ký tự; {metric})\")
