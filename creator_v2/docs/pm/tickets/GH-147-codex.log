 LIMIT = 4900   # YouTube cắt mô tả ở 5.000 byte; tiếng Việt có dấu tốn 2–3 byte mỗi ký tự
+AI_DISCLOSURE = "Một số hình minh hoạ được tạo bằng AI."
 
 
+def _is_ai_image(key, spec: dict, od: Path) -> bool:
+    if not isinstance(key, str):
+        return False
+    if re.fullmatch(r"ai\d+", key, re.I):
+        return True
+    if str((spec.get("imgs") or {}).get(key, "")).startswith("EXT:ai"):
+        return True
+    try:
+        meta = json.loads((od / "img" / f"{key}.json").read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return False
+    return str(meta.get("file", "")).startswith("EXT:ai")
+
+
+def with_ai_disclosure(lines: list[str], uses_ai: bool) -> list[str]:
+    """Đặt đúng một dòng công khai về ảnh AI, không lặp khi dựng lại."""
+    if not uses_ai:
+        return lines
+    kept, seen = [], False
+    for line in lines:
+        if line == AI_DISCLOSURE:
+            if seen:
+                continue
+            seen = True
+        kept.append(line)
+    if not seen:
+        kept += ["", AI_DISCLOSURE]
+    return kept
+
+
 def main(topic, shrink=0):
     sd, od = ROOT / "data" / "long" / topic, ROOT / "output" / "long" / topic
     spec = json.loads((sd / "spec.json").read_text(encoding="utf-8"))
