index 0000000000000000000000000000000000000000..1ae5cf06239e980a0db090e444659c33626ffff8
--- /dev/null
+++ b/creator_v2/tests/test_gh147_ai_media.py
@@ -0,0 +1,63 @@
+"""Hồi quy luật hiển thị và mô tả ảnh AI Long của GH-147."""
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(ROOT / "motion" / "long"), str(ROOT / "motion"), str(ROOT)]
+
+import build_long as BL  # noqa: E402
+import describe as DS  # noqa: E402
+
+
+def chapters(*scenes):
+    return [("ch00", {"scenes": list(scenes)})]
+
+
+def test_mim_ai_image_loses_only_illustration_label(tmp_path):
+    scene = {"img": "ai01", "illus": "ẢNH MINH HỌA", "credit": False, "tone": "color"}
+    changed = BL.strip_ai_illustration_labels(
+        {"channel": "MIM", "imgs": {"ai01": "EXT:ai:ai_01"}}, chapters(scene), tmp_path)
+
+    assert changed is True
+    assert "illus" not in scene
+    assert scene["credit"] is False
+    assert scene["tone"] == "color"
+
+
+def test_real_image_illustration_label_is_preserved(tmp_path):
+    scene = {"img": "archive", "illus": "ẢNH MINH HỌA · MÁY CÙNG LOẠI", "credit": False}
+    BL.strip_ai_illustration_labels(
+        {"channel": "CK", "imgs": {"archive": "File:machine.jpg"}}, chapters(scene), tmp_path)
+
+    assert scene["illus"] == "ẢNH MINH HỌA · MÁY CÙNG LOẠI"
+
+
+def test_cl_keeps_its_existing_ai_illustration_label(tmp_path):
+    scene = {"img": "ai01", "illus": "ẢNH MINH HỌA", "credit": False}
+    changed = BL.strip_ai_illustration_labels(
+        {"channel": "CL", "imgs": {"ai01": "EXT:ai:ai_01"}}, chapters(scene), tmp_path)
+
+    assert changed is False
+    assert scene["illus"] == "ẢNH MINH HỌA"
+
+
+def test_ai_sidecar_is_recognized_without_an_ai_named_key(tmp_path):
+    img = tmp_path / "img"
+    img.mkdir()
+    (img / "painting.json").write_text('{"file": "EXT:ai:painting"}', encoding="utf-8")
+    scene = {"img": "painting", "illus": "ẢNH MINH HỌA", "credit": False}
+
+    BL.strip_ai_illustration_labels({"channel": "MIM", "imgs": {}}, chapters(scene), tmp_path)
+
+    assert "illus" not in scene
+    assert scene["credit"] is False
+
+
+def test_ai_disclosure_is_present_exactly_once():
+    lines = ["Tóm tắt", DS.AI_DISCLOSURE, "", DS.AI_DISCLOSURE]
+
+    result = DS.with_ai_disclosure(lines, uses_ai=True)
+
+    assert result.count(DS.AI_DISCLOSURE) == 1
+    assert DS.with_ai_disclosure(["Tóm tắt"], uses_ai=False) == ["Tóm tắt"]

