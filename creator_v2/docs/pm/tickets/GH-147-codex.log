LIMIT = 4900   # YouTube cắt mô tả ở 5.000 byte; tiếng Việt có dấu tốn 2–3 byte mỗi ký tự


def main(topic, shrink=0):
    sd, od = ROOT / "data" / "long" / topic, ROOT / "output" / "long" / topic
    spec = json.loads((sd / "spec.json").read_text(encoding="utf-8"))
    meta = dict(spec.get("youtube", {}))
    if shrink:   # mô tả quá dài (video nhiều ảnh): bỏ tên ảnh, ghi tác giả đầy đủ + số ảnh theo từng giấy phép (CC cần tác giả và giấy phép)
        meta["credit_by_len"] = max(16, 44 - 8 * shrink)
    used, music, chapters, t, vids = set(), [], [], 0.0, set()
    mim = spec.get("channel") in FOOTER          # kênh MIM / CK: mô tả kiểu "nguồn gốc"
    for c in spec["chapters"]:
        ch = json.loads((sd / f"{c}.json").read_text(encoding="utf-8"))
        for s in ch["scenes"]:
            for k in (s.get("img"), s.get("bg"), (s.get("a") or {}).get("img"), (s.get("b") or {}).get("img"), *[q.get("img") for q in s.get("pins") or []]):
                if k:
                    used.add(k)
            if s.get("vid"):
                vids.add(str(s["vid"]))
        bg = ch.get("bgm") or []
        picks = variety._picks(topic)   # bgm chọn theo mood: file nằm trong bgm_picks.json
        for b in [q.get("file") or picks.get(f"{c}.{k}") for k, q in enumerate([bg] if isinstance(bg, dict) else bg)]:
            if b and b not in music:
                music.append(b)
        title = ch["hud"]["t"].title() if c != "ch00" else meta.get("ch00_title", "Mở đầu")
        if mim:                                      # tiêu đề chương viết tay (.title() làm hỏng chữ hoa kiểu "AI")
            title = meta.get("chapter_titles", {}).get(c, title)
        elif c == spec["chapters"][-1]:
            title = "Kết: " + title
        chapters.append(f"{int(t // 60):02d}:{int(t % 60):02d} {title}")
        t += json.loads((od / c / "timing.json").read_text(encoding="utf-8"))["duration"]
    lines = [meta.get("summary", ""), "", *meta.get("more", []), "", "⏱ CHƯƠNG", *chapters, "", "📚 NGUỒN THAM KHẢO (Wikipedia tiếng Anh và các nguồn được trích trong đó)",
             SRC_SLOT, "và các bài Wikipedia liên quan.", "",
             "Lời dẫn là bản viết mới dựa trên tư liệu công khai; những câu có nhãn DIỄN Ý là diễn đạt lại, không phải nguyên văn.",
             "Hình ảnh/video có nhãn MINH HỌA chỉ mang tính minh họa bối cảnh.", "", "🖼 ẢNH (Wikimedia Commons và các kho tư liệu mở)"]
    pd, bylic, pdsrc = 0, {}, set()
    INST = {"wellcome": "Wellcome Collection", "artic": "Art Institute of Chicago"}
    for k in sorted(used):
        f = spec["imgs"][k]
        if str(f).startswith("EXT:ai:"):   # 29/10: ảnh AI không ghi công, không đếm vào "phạm vi công cộng"
            continue
        mp = od / "img" / f"{k}.json"
        m = json.loads(mp.read_text(encoding="utf-8"))
        if m["license"].lower().startswith(("public", "pd", "cc0", "no restr")):
            pd += 1
            if m.get("source", "").split(":")[0] in INST:   # PD từ kho bảo tàng: vẫn ghi tên kho (lịch sự, không bắt buộc)
                pdsrc.add(INST[m["source"].split(":")[0]])
            continue
        by = re.sub(r"\s*\d\d:\d\d, .*UTC\)", "", m["artist"].split("\n")[0]).strip() or "không rõ tác giả"
        src = {"wellcome": " · Wellcome Collection", "artic": " · Art Institute of Chicago"}.get(m.get("source", "").split(":")[0], "")
        if m.get("source", "").startswith("europeana:"):
            src = " · " + m["source"].split(":", 1)[1]
        if m.get("source") == "sentinel2":                        # Copernicus: ghi đúng câu bắt buộc
            bylic.setdefault("Copernicus Sentinel data", []).append(m["artist"])
            continue
        name = re.sub(r"\s*\(\d{6,}\)|\.(jpe?g|png|tif)$|, Sicily, Italy| - panoramio", "", m.get("title") or f[5:], flags=re.I)[:meta.get("credit_name_len", 48)]
        by = re.sub(r"^The original uploader was |No machine-readable author provided\. ", "", by)
        bylic.setdefault(m["license"], []).append(by[:meta["credit_by_len"]].strip() + src if shrink else f"{name.strip()} ({by[:meta.get('credit_by_len', 40)].strip()}{src})")
    if not any(str(spec["imgs"][k]).startswith("EXT:") for k in used):   # chỉ Commons -> giữ tiêu đề cũ
        lines = [x.replace("🖼 ẢNH (Wikimedia Commons và các kho tư liệu mở)", "🖼 ẢNH (Wikimedia Commons)") for x in lines]
    if shrink:   # gộp tác giả trùng: "Tên (3 ảnh)"
        bylic = {lic: [a + (f" ({v.count(a)} ảnh)" if v.count(a) > 1 else "") for a in dict.fromkeys(v)] for lic, v in bylic.items()}
    lines += [f"• {lic}: " + "; ".join(v) for lic, v in sorted(bylic.items())]   # gom theo giấy phép: đủ tác giả + giấy phép, ít byte hơn
    lines += [f"• Và {pd} ảnh tư liệu thuộc phạm vi công cộng (Public domain / CC0)" + (f", gồm ảnh từ {', '.join(sorted(pdsrc))}." if pdsrc else "."), "",
              "🎬 VIDEO B-ROLL: Pexels (pexels.com) — giấy phép Pexels, dùng tự do."]
    mac = [b for b in music if b in MUSIC]
    if music:
        lines += ["", "🎵 NHẠC NỀN"]
    if mac:
        lines.append(", ".join(f"\"{MUSIC[b]}\"" for b in mac) + " by Kevin MacLeod (incompetech.com)")
        lines.append("Licensed under Creative Commons: By Attribution 4.0 License — http://creativecommons.org/licenses/by/4.0/")
    for b in music:   # bản thu tự do từ Commons: ghi tên file + giấy phép (json cạnh file nhạc)
        mj = od / "bgm" / (Path(b).stem + ".json")
        if b not in MUSIC and mj.exists():
            m = json.loads(mj.read_text(encoding="utf-8"))
            name = re.sub(r"\.(flac|ogg|oga|wav|mp3)$", "", m["file"][5:], flags=re.I)
            lines.append(f"Mascagni — Intermezzo (Cavalleria rusticana) · {m.get('short', name[:40])} — Wikimedia Commons — {m['license']}")
    lines += ["", " ".join("#" + x for x in meta.get("hashtags", []))]
    if mim:
        lines = mim_lines(spec, meta, chapters, used, vids, music, od)
    else:
        lines = sources_for_description(lines, meta.get("sources", []), LIMIT)
    text = "\n".join(lines).strip() + "\n"
    if not mim and len(text.encode("utf-8")) > LIMIT and shrink < 8:
        return main(topic, shrink + 1)
    (od / "description.txt").write_text(text, encoding="utf-8")
    print(text)
    n = len(text.encode("utf-8"))
    print(f"[{n} byte" + (", ghi công rút gọn theo tác giả" if shrink else "") + ("" if n <= LIMIT else " — VẪN QUÁ 5.000 BYTE, phải bớt tay") + "]")


### Ảnh AI khi không có ảnh tự do (từ 26/10/2026)

Cảnh cần minh hoạ mà không có ảnh PD/CC0/CC BY (ví dụ cảnh trong phòng làm việc năm 1962, hay một vật đã mất) thì **không tự tạo ảnh**. Ghi prompt vào `data/long/<topic>/ai_prompts.md` để chủ kênh nhờ bot tạo.

**Định dạng một mục:**

```
#### ai_01.png — <cảnh dùng ở chNN, câu số N>
- Prompt (tiếng Anh): <mô tả chi tiết: bối cảnh, thời kỳ, ánh sáng, bố cục, phong cách>
- Khung: 16:9, 1920x1080
- Cấm: chữ hoặc số trong ảnh, logo, khuôn mặt nhận ra được của người thật
- Phong cách: <ví dụ "painterly editorial illustration, muted 1960s palette">
```

**Quy tắc:**
- **Người thật: lấy dáng gốc, không vẽ mặt** (chủ kênh, 26/10/2026):
  - Được vẽ người có thật (Johnson, Glenn…) theo **dáng gốc** trong ảnh tư liệu: vóc người, kiểu tóc, trang phục, đồ vật, bối cảnh đúng thời kỳ.
  - Chỉ vẽ ở **góc nghiêng quay đi hoặc từ phía sau**, không thấy rõ mặt.
  - Trong prompt, ghi ảnh tư liệu tham chiếu (URL Commons/NASA trong `facts.md`) và mô tả dáng cụ thể. Ví dụ: "woman in 1960s cat-eye glasses and cardigan, seen from behind at a desk with mechanical calculator".
  - Mặt người thật chỉ dùng ảnh tư liệu PD.
- **Phong cách:** minh hoạ hoặc tranh vẽ, **không giả ảnh tư liệu**, để người xem không nhầm là tư liệu thật.
- **Không gắn nhãn AI:** không thêm nhãn "AI" trên màn hình hay trong mô tả, vì bản thân ảnh đã có chữ ký AI (chủ kênh quyết định ngày 26/10/2026).
- **Đường dẫn:**
  - Chủ kênh thả ảnh vào `motion/hf/assets/long/<topic>/img/ai/ai_NN.png`.
  - Engine chỉ đọc `output/long/<topic>/img/aiNN.jpg` kèm `.json`. Claude chạy `python scripts/ai_img_import.py <topic>` để chép ảnh sang chỗ đó.
  - Từ 26/10, Claude chạy `python scripts/ai_img_request.py <topic>`. Lệnh này gửi `ai_prompts.md` cho bot tạo ảnh qua webhook (khoá đọc từ registry User, xem `docs/tools/grokbot-webhook.md`), chờ ảnh về rồi chạy `ai_img_import`. **Agent sản xuất không gọi webhook**: chỉ viết prompt.
  - Trong `IMGS`, khai key `aiNN` là `"EXT:ai:ai_NN"`.
- **Ghi công:** cảnh dùng ảnh AI phải có `"credit": false`. Nếu thiếu, engine in "ẢNH: TƯ LIỆU · PHẠM VI CÔNG CỘNG", tức là gắn nhãn tư liệu cho tranh minh hoạ, sai sự thật. Nhãn `illus` "ẢNH MINH HỌA" thì giữ, vì đó là nhãn chuẩn cho tranh minh hoạ.
- **Khi chưa có ảnh:** giữ nguyên cảnh và đường dẫn, rồi ghi trong báo cáo "chờ N ảnh AI". `html` hoặc `long_gate` có thể báo thiếu file; điều đó chấp nhận được cho tới khi ảnh về.
- **Giới hạn:** tối đa 6 ảnh AI cho một bài 9–11 phút. Ưu tiên ảnh tư liệu thật.

### Quy trình Long (theo mẫu `data/long/mim-ke-huy-diet-petrov`, `mim-google-maps-kal007`)

  - Câu đầu phải là một trong ba thứ: sự kiện có thật kèm ngày, con số thật có nguồn, hoặc câu hỏi thật của người xem.
  - Ví dụ giả định chỉ vào từ CH01 trở đi, và nói rõ là ví dụ.
- **Cấu trúc documentary:** hook → vấn đề → bối cảnh → bằng chứng và dữ liệu → nghịch lý hoặc bước ngoặt → phân tích → kết luận. Không chạy slide chữ liên tục.
- **Thumbnail:**
  - 3–6 chữ lớn, một hình hoặc một cặp đối lập.
  - **Không ghi "VÍ DỤ GIẢ ĐỊNH"** trên thumbnail; giả định thì nói rõ trong video.
  - Không dùng biểu đồ nhỏ nhiều chữ, không dùng hình không liên quan.
- **Ảnh:** ưu tiên tư liệu thật (sự kiện, nhân vật) khi có quyền dùng. Không giả làm ảnh tư liệu: ảnh AI luôn mang nhãn ẢNH MINH HỌA.
- **Độ dài thử nghiệm:** MIM 10–15 phút, CK 8–13 phút. Chỉ làm 20–30 phút khi chủ đề thật sự cần.

## Cấm lách cổng bằng cảnh đệm (27/10/2026, lô CK 18–22/11)

**Neo thời gian:** `a(line, word)` neo cảnh vào câu `line` của chương, tại từ `word`. `word` phải là chữ **có thật trong câu đó**, không phải số và không phải chữ có trong `SAY`.

| Helper | Dùng khi |
|---|---|
| `chapter(no, k, title, sub, bg, title_at)` | Cảnh đầu mỗi chương. `k = "CHƯƠNG MỘT"`; `sub` = mốc có nguồn; `bg` = key ảnh |
| `photo(img, at, key, value, kin=None)` | Ảnh tư liệu hoặc ảnh AI. Ảnh AI tự có `illus` + `credit: False` |
| `print_scene(img, at, head, key, value)` | Ảnh đặt như tờ in, có cột ghi chú |
| `broll(vid, at, text)` | Clip Pexels (id số), có nhãn VIDEO MINH HỌA |
| `kinetic(at, text, small=None)` | Chữ lớn động |
| `slam(at, text, sub)` | Một con số hoặc cụm từ đập mạnh |
## Luật nội dung

- **Sự thật:** mỗi khẳng định có số, ngày hoặc tên đều phải có một dòng trong `factcheck.md`, kèm URL đã mở được. Không mở được nguồn thì không đọc thành khẳng định: hoặc bỏ, hoặc nói rõ "theo …". Không bịa trích dẫn. Lời trích là bản dịch thì gắn `[TRÍCH DỊCH]`.
- **Ảnh:**
  - MIM chỉ nhận PD, CC0, CC BY. Không nhận CC BY-SA, GFDL, NC, ND.
  - Không dùng hình phim; phim chỉ được nhắc bằng lời và chữ.
  - Không gắn nhãn tên người thật lên clip stock của người lạ.
  - Clip không được lộ logo hay chữ đọc được của thương hiệu.
- **Mô tả công khai** (`spec.youtube.*`, `description`) không được chứa: `<`, `>`, "CẦN", "cần kiểm", "WebFetch", "factcheck", "data/long", "tìm kiếm", "agent". Ghi chú làm việc để trong `sources_internal`.
- **CK:**
  - Không nêu tên ngân hàng thương mại, công ty chứng khoán, hãng xe hay mã cổ phiếu.
  - Không nói "nên mua/bán".
  - Số tự giả định phải ghi "VÍ DỤ GIẢ ĐỊNH".
  - Mô tả có câu "Nội dung giáo dục, không phải tư vấn đầu tư."
- **Tiêu đề** ≤ 60 ký tự. MIM: người + năm + bước ngoặt, hoặc khuôn "[PHIM/APP] Ngoài Đời Thật: [người thật]". CK: một khoản tiền × một mốc thời gian.
- **Viết cho tai:** câu một hơi, nói với "bạn", số làm tròn dễ nghe. Mã tài liệu và giờ chính xác chỉ hiện trên màn hình. Không mở bài bằng "trả lời ba câu hỏi"; mỗi bài dùng một dạng lộ trình riêng.

## 5. Trạng thái ở checkout này

- Nhánh làm việc `feat/shorts-mix-standard` **chưa có** `webauto`.
- Merge `main` mang theo 278 file (PR #1, #3, #4, khoảng 50 nghìn dòng), trong đó 6 file đang có thay đổi chưa commit ở đây (`casefile.js`, `casewide.*`, `build_long.py`, `describe.py`, `data/variety/ledger.json`).
- Hai cách, chờ chủ kênh chọn:
  - (A) commit công việc hiện tại rồi merge đầy đủ, xử lý xung đột ở engine;
  - (B) chỉ lấy `webauto/`, `docs/webauto.md`, `tests/test_webauto.py`, cùng 2 dòng trong `pyproject.toml` và `.gitignore` từ `main`, để dùng ngay. Merge đầy đủ để sau, vào lúc không có render đang chạy.
  - không đoạn nào quá 25 s không có hình;
  - phần chỉ chữ không quá 30%;
  - ảnh tĩnh không quá 8 s nếu không chia shot.
- **Thứ tự lấp chỗ trống:**
  1. clip hoặc ảnh tự do;
  2. nếu không có, ảnh AI qua `prompt_builder` rồi Grok Bot (`scripts/ai_img_request.py`).
- **Ghi rõ nguồn:** ảnh AI ghi nhãn "ẢNH MINH HỌA AI" và đưa vào `credits.json`.
- **Phạm vi:** không áp cho CL. Luật của CL cấm ảnh AI.
            "MIM": {"voice": "Thanh Bình", "quote": "Ngọc Huyền", "theme": "lab", "brand": "MIND IN THE MACHINE",
                    "accent": "#22d3ee", "pools": themes.THEMES["mim"]["pools"], "no_sa": True},
            # Biểu Đồ Biết Nói (tài chính cá nhân): theme "chart" (chart.js: brand, candles, race, breadth, basket), vàng = giá tham chiếu
            # giọng (người dùng chọn 06/10/2026): dẫn chính Ngọc Huyền · người hỏi Phạm Tuyên · lời trích Xuân Vĩnh
            "CK": {"voice": "Ngọc Huyền", "quote": "Xuân Vĩnh", "ask": "Phạm Tuyên", "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI",
