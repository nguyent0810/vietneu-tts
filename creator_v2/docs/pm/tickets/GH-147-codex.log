def _refuse_floor(topic: str, chs) -> None:
    """Sàn sản xuất theo kênh; render thật/final không được bỏ qua kênh nào."""
    spec = json.loads((paths(topic)[0] / "spec.json").read_text(encoding="utf-8"))
    bad = floor.problems(chs, spec.get("channel", "CL"), topic)
    if bad:
        raise SystemExit(f"floor ({topic}): video này kém các Long đã đăng, không dựng bản thật:\n  " + "\n  ".join(bad))


def do_html(topic, only=None):
    _refuse_html_lint(topic, only)   # chặn trước khi tải ảnh và trộn tiếng
    spec, chs, od = load(topic)
    # ``plan()`` resolves cue aliases (hitAt/typeAt/countAt) before the engine
    # sees a scene. At this point only check image declarations; the complete
    # scene contract runs below on each planned scene.
    source_check = scene_params.validate_topic(
        ((name, ch.get("scenes") or []) for name, ch in chs if not only or name in only),
        spec.get("imgs") or {}, THEME["name"], check_scenes=False,
    )
    if source_check["errors"]:
        raise SystemExit("tham số cảnh:\n  " + "\n  ".join(source_check["errors"]))
    for warning in source_check["warnings"]:
        print(f"  ! WARNING tham số cảnh: {warning}", flush=True)
    _refuse_craft(topic, spec, chs)
    durs = {}
    for name, ch in chs:
        tj = od / name / "timing.json"
        durs[name] = json.loads(tj.read_text(encoding="utf-8"))["duration"] if tj.exists() else 150.0   # chương chưa đọc: ước lượng
    total, acc_t = sum(durs.values()), 0.0
    credits = {}
    imgs = {}
    if beat2_advice(spec):
        print(f"  ! WARNING {beat2_advice(spec)}", flush=True)
    bad_src = ck_source_brands(spec)
    if bad_src:
        raise SystemExit("CK: nguồn trong mô tả là trang của công ty chứng khoán/ngân hàng (luật kênh: không tên thương hiệu): " + ", ".join(bad_src))
    variety.resolve_bgm(topic, spec, chs, od)   # bgm {"mood": ...} -> file cụ thể, tối thiểu trùng với video gần đây (retro 3 mục 9)
    look = variety.look(spec.get("look"))
    for key, file in spec.get("imgs", {}).items():
        wh = fetch_img(file, od / "img" / f"{key}.jpg", credits)
        imgs[key] = {"src": f"assets/long/{topic}/img/{key}.jpg", **wh}
    geo = {}
    for gname, g in (spec.get("geo") or {}).items():
        hf_geo.BOX = tuple(g.get("box", (180, 130, 1740, 850)))
        geo[gname] = hf_geo.bake({"countries": g["countries"], "context": g.get("context", []), "labels": g.get("labels", {}),
                                  "bbox": g["bbox"], "pins": g["pins"]})["_geo"]
    (od / "credits.json").write_text(json.dumps(credits, ensure_ascii=False, indent=1), encoding="utf-8")
    vdur = {}
    for name, ch in chs:
        d = durs[name]
        if only and name not in only:
            acc_t += d
            continue
        t = json.loads((od / name / "timing.json").read_text(encoding="utf-8"))
        lines = word_lines(t, od / name / "voice.wav")
        scenes = plan(ch, lines, d)
        ec = spec.get("endcard", 0) if name == spec["chapters"][-1] else 0
        if ec:   # 20 giây cuối cho end screen: kéo dài chương cuối, nhạc nền chạy tiếp rồi tắt dần
            scenes.append({"type": "endcard", "t0": d, "t1": d + ec, "bg": spec.get("endcardBg"),
                           "sub": spec.get("endcardSub", None if THEME["name"] == "lab" else "HỒ SƠ TIẾP THEO")})
            d = d + ec
        planned_check = scene_params.validate_topic([(name, scenes)], None, THEME["name"])
        if planned_check["errors"]:
            raise SystemExit("tham số cảnh:\n  " + "\n  ".join(planned_check["errors"]))
        for warning in planned_check["warnings"]:
            print(f"  ! WARNING tham số cảnh: {warning}", flush=True)
        late = late_first(scenes, name)
        if late:
            raise SystemExit("nhịp cảnh:\n  " + "\n  ".join(late))
        vids = []
        for k, s in enumerate(scenes):
            if s.get("vid"):
                vid = str(s["vid"])
                src = od / "broll" / f"{vid}.mp4"
                import mediafit
                if src.exists() and mediafit.decide(*mediafit.probe(src), 1920, 1080) == "blur":
                    fit = od / "broll" / f"{vid}fit.mp4"     # tên chỉ gồm số + "fit": khớp regex kiểm clip lúc render
                    if not fit.exists():
                        mediafit.fit_video(src, fit, 1920, 1080, seconds=600)
                        print(f"  mediafit: clip {vid} lệch khung ngang -> đặt trọn hình trên nền nhoè ({fit.name})")
                    src, vid = fit, f"{vid}fit"
                if vid not in vdur:
                    vdur[vid] = probe_dur(src)
                ms = float(s.get("ms", 0))
                need = s["t1"] - s["t0"] + 0.5
                if ms + need > vdur[vid] + 0.05:
                    raise SystemExit(f"{name} cảnh {k}: clip {vid} dài {vdur[vid]:.1f}s, cần {ms:.1f}+{need:.1f}s")
                s["vid"] = f"v{k}"
                tone = {"bw": "bw", "noir": "noir", "color": "color", "night": "night", "dim": "dimbg", "sepia": "sepia"}[s.get("tone", "night")]
                st = max(0.0, s["t0"] - 0.2)
                vids.append(f'  <video id="v{k}" class="clip bv {tone}" src="assets/long/{topic}/broll/{vid}.mp4" data-start="{st:.3f}" '
                            f'data-duration="{min(need, d - st):.3f}" data-media-start="{ms:.2f}" muted playsinline data-track-index="1"></video>')
        bad = [c for k, sc in enumerate(scenes) for c in unresolved_cues(sc, f"{sc['type']}#{k}")]
        if bad:
            raise SystemExit(f"{name}: mốc chưa đổi ra giây (thêm khoá vào BLD.ANCHORS): " + "; ".join(bad))
        # Retro 5 (14/10/2026): (a) "label" của cảnh bars/chart là thẻ góc dưới trái, đè lên nhãn trục (che chữ "MÁY", "99% THẮNG");
        # nguồn/ghi chú của biểu đồ đặt vào "unit". (b) counter có chữ số trong "prefix": số trung gian "1 / 7.698" đọc như dữ kiện thật.
        over = [f"{sc['type']}#{k}: label {sc['label'].get('k') or sc['label'].get('v')!r}" for k, sc in enumerate(scenes)
                if sc["type"] == "chart" and isinstance(sc.get("label"), dict)]   # bars: engine đã vẽ label thành dòng chú thích dưới tiêu đề
        if over:
            raise SystemExit(f"{name}: label đè nhãn trục biểu đồ (chuyển sang \"unit\"): " + "; ".join(over))
        pre = [f"counter#{k}: prefix {sc['prefix']!r}" for k, sc in enumerate(scenes)
               if sc["type"] == "counter" and any(c.isdigit() or c in "<>≈~" for c in str(sc.get("prefix") or "")) and sc.get("from", 0) != sc["to"]]
        if pre:   # retro 15/10/2026: thêm "<>≈~" cho khớp gate Shorts ("> 1.478 QUYẾT ĐỊNH" giữa chừng)
            raise SystemExit(f"{name}: counter có chữ số/dấu so sánh trong prefix (đặt \"from\" = \"to\" hoặc dùng kinetic): " + "; ".join(pre))
        tl = re.findall(r"~\s*\d[\d.,]*", json.dumps(scenes, ensure_ascii=False))
        if tl:    # retro 15/10/2026: "~120" trên màn hình đọc thành "-120"
            raise SystemExit(f"{name}: dấu ~ trước số dễ đọc thành dấu trừ (dùng ≈): " + ", ".join(tl))
        wide = ledger_overflow(scenes, THEME["name"])
        if wide:
            raise SystemExit(f"{name}: dòng sổ dài hơn thẻ (rút gọn khoá/giá trị): " + "; ".join(wide))
        bc = bars_collide(scenes)
        if bc:
            raise SystemExit(f"{name}: tiêu đề biểu đồ đè chú thích (rút gọn một trong hai): " + "; ".join(bc))
        seed = sum(ord(c) * (i + 1) for i, c in enumerate(topic + name)) % 100000 + 7
        case = {"topic": topic, "ch": name, "dur": d, "seed": seed, "accent": spec.get("accent", CHAN.get("accent", "#e2402d")), "look": look,
                "theme": THEME["name"] or None, **({"brand": CHAN["brand"]} if CHAN.get("brand") else {}), "autoTr": spec.get("autoTr", spec.get("theme") == "shanghai"), "hud": ch.get("hud", {}),
                "acc": spec.get("acc", []) + ch.get("acc", []), "lines": lines, "imgs": imgs, "geo": geo, "scenes": scenes,
                "prog0": round(acc_t / total, 5), "prog1": min(1.0, round((acc_t + d) / total, 5))}
        (od / name / "data.js").write_text("window.CASE = " + json.dumps(case, ensure_ascii=False) + ";\n", encoding="utf-8")
        comp = HF / "compositions" / "long" / f"{topic}_{name}.html"
        comp.parent.mkdir(parents=True, exist_ok=True)
        comp.write_text(html_for().replace("{fonts}", variety.fonts_url(spec.get("look"))).replace("{data}", f"assets/long/{topic}/{name}/data.js").replace("{dur}", f"{d:.3f}")
                        .replace("{title}", spec["title"]).replace("{videos}", "\n".join(vids)), encoding="utf-8")
        sfx_long.build(case, od / name / "sfx.wav")
        quiet = [(s["t0"], s["t1"]) for s in scenes if s["type"] == "question"]
    thumb = find_thumb(od, y.get("thumb", "t1.jpg"))
    if channels.upload_mode(ch) == "manual":
        # Kênh upload TAY (MIM): ghi kho (bundle + video + thumbnail), ghi sổ đa dạng, rồi xuất gói -- KHÔNG gọi API upload.
        b = long_bundle(topic, ch, publish_at, sd, od)
        with store.connect() as conn:
            register(conn, b, res, od / "final.mp4", Channel.open(ch, conn))
            if thumb.exists():
                conn.execute("UPDATE item SET thumb_path = ? WHERE id = ?", (str(thumb), b.id))
        import variety
        variety.record(topic, publish_at[:10])
        print(f"đã vào kho: {b.slug}. Xuất gói upload tay:  python scripts/export_manual.py --channel {ch}")
        return
    creds = json.loads(channels.creds_path(ch).read_text(encoding="utf-8"))
    tok = P.access_token(creds)       # cho các bước còn lại (phụ đề, playlist)

    if not res.get("video_id"):
        missing = preflight(od, thumb)
        if missing:      # upload là bước KHÔNG rút lại được: thiếu gì thì dừng TRƯỚC, không đăng nửa vời
            raise SystemExit(f"preflight: thiếu {', '.join(missing)} trong {od} — chưa upload gì")
        qa = od / "qa_ok"      # retro 15/10/2026: qa_ok đánh dấu tay, không gắn với file -> có thể đăng bản đã đổi sau QA
        if qa.exists():
            import hashlib
            h = hashlib.sha256((od / "final.mp4").read_bytes()).hexdigest()
            if qa.read_text(encoding="utf-8").strip() != h:
                raise SystemExit(f"qa_ok không khớp final.mp4 hiện tại (đã dựng lại sau QA?) — QA lại rồi: python scripts/qa_mark.py {topic}")
    b = long_bundle(topic, ch, publish_at, sd, od)
    with store.connect() as conn:
        register(conn, b, res, od / "final.mp4", Channel.open(ch, conn))
        if not res.get("video_id"):
            if wait:      # ngủ tới lượt TRƯỚC khi chụp tiêu đề kênh + lấy token mới (chờ có thể nhiều giờ)
                wait_turn(Channel.open(ch, conn))
                tok = P.access_token(creds)
            titles = P.channel_titles(P.uploads_playlist_id(tok), tok)
            chan = Channel.open(ch, conn, channel_titles=titles)
            print("upload…", flush=True)
            try:
                u = Upload(
                    slug=f"long-{topic}", video=od / "final.mp4", title=spec["title"],
                    description=(od / "description.txt").read_text(encoding="utf-8"),
                    tags=tuple(y["tags"]), kind="long", publish_at=publish_at,
                    category=y.get("category", "24"), thumbnail=thumb)
                up = upload_when_free(chan, u) if wait else chan.upload(u)
            except P.PublishError as e:
                # PacingHold / UploadInterrupted: chạy lại lệnh này là đủ (nối
                # tiếp phiên cũ, không upload lại). UploadInDoubt: xem Studio rồi
                # `publish_batch.py resolve long-<topic> <video_id|none> --channel <CH>`.
                raise SystemExit(f"{type(e).__name__}: {e}")
            res.update(video_id=up.video_id, publish_at=up.publish_at, meta_fixed=True)
            if up.thumbnail_error is None and not up.reused:
                res["thumb"] = thumb.name
            save()
            store.mark(conn, b.id, "published", video_id=up.video_id)
            print("video", res["video_id"], flush=True)
        else:
            chan = Channel.open(ch, conn)
        vid = res["video_id"]

        if not res.get("meta_fixed"):   # video upload trước khi có Channel: category còn là 22
            chan.edit(vid, categoryId=y.get("category", "24"))
            res["meta_fixed"] = True
            save()
            print("category OK", flush=True)

        if not res.get("thumb"):
            chan.set_thumbnail(vid, thumb)
            res["thumb"] = thumb.name
            save()
            print("thumbnail OK", flush=True)

    tok = P.access_token(creds)       # upload dài có thể quá hạn token cũ
    if not res.get("captions"):
        try:
            res["captions"] = captions_insert(tok, vid, od / "captions.vi.srt")
            res.pop("captions_error", None)
            print("phụ đề OK", flush=True)
        except P.PublishError as e:
            res["captions_error"] = str(e)
            print("phụ đề LỖI:", e, flush=True)
        save()

    if "--playlist" in rest and not res.get("playlist_id"):
        i = rest.index("--playlist")
        name, desc, *ids = rest[i + 1:]
        pl = P._api(tok, "POST", "playlists", {"part": "snippet,status"},
                    {"snippet": {"title": name, "description": desc, "defaultLanguage": "vi"}, "status": {"privacyStatus": "public"}})
        res["playlist_id"] = pl["id"]
        res["playlist_items"] = []
        save()
        print("playlist", pl["id"], flush=True)
    if res.get("playlist_id") and "--playlist" in rest:
        ids = rest[rest.index("--playlist") + 3:]
        for v in [vid] + [x for x in ids if x != vid]:
            if v in res["playlist_items"]:
                continue
            P.add_to_playlist(v, res["playlist_id"], tok)
"""publish_long: đủ đồ TRƯỚC upload + tìm thumbnail ở cả hai chỗ (retro 2 mục 19).

07/10: thumb.py ghi t1.jpg thẳng vào output/long/<topic>/, publish_long chỉ nhìn pub/ -> MIM #2 (sP0ch8-NYec) lên kênh không
thumbnail, rồi sập khi ghi pub/result.json (thư mục chưa có) -> không phụ đề, chuỗi tưởng xong và đăng tiếp teaser.
"""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT / "motion" / "long"), str(ROOT / "motion"), str(ROOT)]
import publish_long as PL  # noqa: E402


def test_thumbnail_found_in_topic_dir_when_pub_has_none(tmp_path):
    (tmp_path / "t1.jpg").write_bytes(b"j")
    assert PL.find_thumb(tmp_path) == tmp_path / "t1.jpg"
    (tmp_path / "pub").mkdir()
    (tmp_path / "pub" / "t1.jpg").write_bytes(b"j")
    assert PL.find_thumb(tmp_path) == tmp_path / "pub" / "t1.jpg"      # pub/ (cách cũ) vẫn ưu tiên


def test_preflight_lists_every_missing_piece(tmp_path):
    assert PL.preflight(tmp_path, PL.find_thumb(tmp_path)) == ["final.mp4", "description.txt", "captions.vi.srt", "t1.jpg"]
    for n in ("final.mp4", "description.txt", "captions.vi.srt", "t1.jpg"):
        (tmp_path / n).write_bytes(b"x")
    assert PL.preflight(tmp_path, PL.find_thumb(tmp_path)) == []


def test_main_checks_before_upload_and_creates_pub_dir():
    src = (ROOT / "motion" / "long" / "publish_long.py").read_text(encoding="utf-8")
    assert src.index("missing = preflight(od, thumb)") < src.index("chan.upload(u)")
    assert "rp.parent.mkdir(parents=True, exist_ok=True)" in src

"""Video dài vào cùng kho với short (bước 4, docs/audit/2026-10-05-one-store-design.md)."""
import json
import sys
from pathlib import Path

import pytest

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "motion" / "long"))
import publish_long as pl  # noqa: E402

from factory import store  # noqa: E402
from factory.channel import Channel  # noqa: E402
from factory.youtube_fake import FakeYouTube  # noqa: E402


@pytest.fixture
def env(tmp_path):
    sd, od = tmp_path / "data" / "long" / "kowloon", tmp_path / "out"
    sd.mkdir(parents=True)
    od.mkdir()
    (sd / "spec.json").write_text(json.dumps({
        "title": "Cửu Long Thành Trại ngoài đời thật", "chapters": ["ch00", "ch01"],
        "youtube": {"tags": ["kowloon"], "sources": ["https://en.wikipedia.org/wiki/Kowloon_Walled_City"]}}),
        encoding="utf-8")
    (sd / "ch00.json").write_text(json.dumps({"lines": [{"t": "Chương một.", "p": 0.8}, "Câu hai."]}), encoding="utf-8")
    (sd / "ch01.json").write_text(json.dumps({"lines": ["Câu ba."]}), encoding="utf-8")
    (od / "description.txt").write_text("Mô tả dài.", encoding="utf-8")
    yt = FakeYouTube()
    with store.connect(tmp_path / "state.sqlite") as conn:
        yield {"conn": conn, "sd": sd, "od": od, "bundles": tmp_path / "bundles", "yt": yt,
               "chan": Channel("CL", yt, conn)}


def bundle(env, when="2026-11-01T12:00:00Z"):
    return pl.long_bundle("kowloon", "CL", when, env["sd"], env["od"])


def row(env, b):
    return tuple(env["conn"].execute("SELECT stage, video_id, engine FROM item WHERE id = ?", (b.id,)).fetchone())


def test_a_long_video_gets_a_casewide_bundle_built_from_its_spec(env):
    b = bundle(env)
    b.validate()
    assert (b.kind, b.slug, b.engine) == ("long", "long-kowloon", "casewide")
    assert b.render["spec"] == "data/long/kowloon/spec.json"
    assert b.script == "Chương một. Câu hai. Câu ba."


def test_register_queues_the_built_video_as_assembled(env):
    b = bundle(env)
    pl.register(env["conn"], b, {}, env["od"] / "final.mp4", env["chan"], env["bundles"])
    assert row(env, b) == ("assembled", None, "casewide")
    assert store.load_bundle("CL", "long-kowloon", env["bundles"]) == b


def test_rerunning_after_upload_never_demotes_published_back_to_assembled(env):
    # Chạy lại publish_long để thêm playlist: video đã lên kênh, không được
    # trông như đang chờ upload (export_manual / publish_batch sẽ đăng lại).
    b = bundle(env)
    pl.register(env["conn"], b, {}, env["od"] / "final.mp4", env["chan"], env["bundles"])
    store.mark(env["conn"], b.id, "published", video_id="vidL")
    pl.register(env["conn"], b, {}, env["od"] / "final.mp4", env["chan"], env["bundles"])
    assert row(env, b)[:2] == ("published", "vidL")


def test_a_video_id_in_result_json_marks_an_old_upload_published_and_puts_it_in_the_ledger(env):
    # Video dài upload trước khi có kho chung: result.json là bằng chứng. Vòng phản
    # hồi chỉ đo video trong upload_log -> phải ghi sổ, không chỉ đổi stage (Grok).
    b = bundle(env)
    old = env["yt"].add_video({"title": "Cửu Long", "publishedAt": "2026-09-20T12:00:00Z"},
                              {"privacyStatus": "public"})
    pl.register(env["conn"], b, {"video_id": old}, env["od"] / "final.mp4", env["chan"], env["bundles"])
    pl.register(env["conn"], b, {"video_id": old}, env["od"] / "final.mp4", env["chan"], env["bundles"])
    assert row(env, b)[:2] == ("published", old)
    led = env["conn"].execute("SELECT state, video_id, started_at FROM upload_log WHERE slug = 'long-kowloon'").fetchone()
    assert tuple(led) == ("done", old, "2026-09-20T12:00:00Z")


def test_the_first_bundle_on_disk_is_kept(env):
    first = bundle(env)
    pl.register(env["conn"], first, {}, env["od"] / "final.mp4", env["chan"], env["bundles"])
    pl.register(env["conn"], bundle(env, "2026-12-01T12:00:00Z"), {}, env["od"] / "final.mp4", env["chan"], env["bundles"])
    assert store.load_bundle("CL", "long-kowloon", env["bundles"]).publish_at == first.publish_at

"""Video dài 16:9 cho kênh MIM (Grok vòng 1, 06/10/2026): một bảng kênh trong build_long.load(), kênh Hình Sự
(spec không ghi "channel") giữ NGUYÊN hành vi. Thiết kế: docs/channels/mind-in-the-machine/2026-10-06-long-design.md.
"""
import json
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT / "motion" / "long"), str(ROOT / "motion"), str(ROOT / "motion" / "stier")]

import beatfx  # noqa: E402
import build_long as BL  # noqa: E402
import variety  # noqa: E402


def topic(tmp_path, monkeypatch, spec):
    sd, od = tmp_path / "data", tmp_path / "out"
    sd.mkdir(exist_ok=True)
    (sd / "spec.json").write_text(json.dumps({"title": "t", "chapters": [], **spec}, ensure_ascii=False), encoding="utf-8")
    monkeypatch.setattr(BL, "paths", lambda t: (sd, od))
    return BL.load("x")[0]


def test_crime_channel_keeps_its_voices_theme_and_no_brand(tmp_path, monkeypatch):
    topic(tmp_path, monkeypatch, {"theme": "noir"})
    assert (BL.VOICE, BL.QUOTE_VOICE, BL.THEME["name"]) == ("Anh Khôi", "Minh Đức", "noir")
    assert BL.CHAN.get("brand") is None and BL.CHAN.get("pools") is None


def test_mim_channel_gets_its_voice_lab_theme_brand_and_pools(tmp_path, monkeypatch):
    topic(tmp_path, monkeypatch, {"channel": "MIM"})
    assert (BL.VOICE, BL.QUOTE_VOICE, BL.THEME["name"]) == ("Thanh Bình", "Ngọc Huyền", "lab")
    assert BL.CHAN["brand"] == "MIND IN THE MACHINE" and BL.CHAN["pools"]["sync"]
    topic(tmp_path, monkeypatch, {})                       # nạp lại spec CL: không dính trạng thái MIM
    assert BL.VOICE == "Anh Khôi" and BL.THEME["name"] == ""


def test_mim_refuses_share_alike_images(tmp_path, monkeypatch):
    topic(tmp_path, monkeypatch, {"channel": "MIM"})
    assert BL.license_allowed("CC BY 2.0") and BL.license_allowed("Public domain")
    assert not BL.license_allowed("CC BY-SA 4.0")
    topic(tmp_path, monkeypatch, {})
    assert BL.license_allowed("CC BY-SA 4.0")                 # kênh Hình Sự: như cũ


def test_sync_covers_kin_overlays_and_respects_a_min_time():
    words = [{"w": "Mùa", "t": 0.1}, {"w": "hè", "t": 0.3}, {"w": "năm", "t": 0.5}]
    sc = [{"type": "photo", "t0": 0.0, "t1": 2.0, "kin": [{"text": "MÙA HÈ", "at": 0.1}]}]
    beatfx.apply_sync(sc, [{"words": words}], min_at=0.0)
    assert sc[0]["kin"][0]["fx"] == "sync"
    sc = [{"type": "photo", "t0": 0.0, "t1": 2.0, "kin": [{"text": "MÙA HÈ", "at": 0.1}]}]
    beatfx.apply_sync(sc, [{"words": words}])                  # mặc định: khung 0 phải có chữ
    assert "fx" not in sc[0]["kin"][0]


def test_bgm_picker_never_crosses_channels(tmp_path, monkeypatch):
    lib = tmp_path / "music"
    lib.mkdir()
    for f in ("dark.mp3", "lab.mp3"):
        (lib / f).write_bytes(b"x")
    monkeypatch.setattr(variety, "LIB", lib)
    monkeypatch.setattr(variety, "catalog", lambda: {"tracks": {
        "dark": {"file": "dark.mp3", "mood": ["epic"]},
        "lab": {"file": "lab.mp3", "mood": ["epic"], "channel": "MIM"}}})
    monkeypatch.setattr(variety, "_picks_path", lambda t: tmp_path / f"{t}.json")
    monkeypatch.setattr(variety, "recent", lambda *a, **k: [])
    for ch, want in (("MIM", "lab.mp3"), ("CL", "dark.mp3")):
        chs = [("ch00", {"bgm": {"mood": "epic"}})]
        variety.resolve_bgm(f"t-{ch}", {"channel": ch} if ch == "MIM" else {}, chs, tmp_path / ch)
        assert chs[0][1]["bgm"]["file"] == want


def test_lab_theme_is_exempt_from_the_look_rule(monkeypatch):
