  },
  {
   "type": "quote",
   "at": 11,
   "text": "Đây là việc nhà ta, khanh đừng dự vào.",
   "by": "TƯ TRỊ THÔNG GIÁM · Q.206",
   "lbl": "TRÍCH DỊCH",
   "qline": 12,
