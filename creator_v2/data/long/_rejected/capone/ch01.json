{
 "title": "Brooklyn, mười bốn tuổi",
 "lines": [
  {
   "t": "Alphonse Gabriel Capone sinh ngày 17 tháng 1 năm 1899, ở Brooklyn.",
   "p": 0.8
  },
  "Cha Gabriele là thợ cắt tóc.",
  "Mẹ Teresa là thợ may.",
  "Hai người từ Angri, gần Naples, tới Mỹ năm 1893.",
  "Năm ông mười bốn tuổi, trường đuổi học vì ông đánh một cô giáo.",
  "Ông làm đủ việc ở Brooklyn.",
  "Cửa hàng kẹo.",
  "Sân bowling.",
  "Từ năm 1916 đến 1918 ông chơi bóng chày bán chuyên.",
  "Rồi Johnny Torrio trở thành người ông gọi là thầy.",
  "Ngày 30 tháng 12 năm 1918, ông cưới Mae Coughlin.",
  "Ông mười chín tuổi.",
  "Con trai Albert, gọi là Sonny, sinh trước đám cưới trong cùng tháng ấy.",
  {
   "t": "Vì chưa đủ hai mươi mốt, cha mẹ phải ký giấy đồng ý.",
   "p": 1.0
  }
 ],
