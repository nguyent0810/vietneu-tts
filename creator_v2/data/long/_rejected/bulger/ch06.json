{
 "title": "Một người hàng xóm ở Iceland",
 "lines": [
  {
   "t": "Chiến dịch tìm ông đánh vào mười bốn thị trường truyền hình.",
   "p": 0.8
  },
  "Trọng tâm không phải mặt ông.",
  "Trọng tâm là Catherine Greig.",
  "Họ mô tả bà là người yêu động vật, hay tới tiệm làm tóc.",
  "Cục nói các vụ bắt là kết quả trực tiếp của chiến dịch ấy.",
  "Rồi có một tin từ một người phụ nữ ở Iceland.",
  "Bà nói ông đang sống trong một căn hộ gần bãi biển Santa Monica.",
  "Tờ Boston Globe xác định người đưa tin là Anna Björnsdóttir.",
  "Bà từng là hoa hậu Iceland năm 1974.",
  "Bà sống cùng khu với ông.",
  "Một ngày sau, người của lực lượng dùng một mẹo.",
  "Họ dụ ông ra khỏi căn hộ.",
  "Bắt ông, không có kháng cự.",
  "Rồi vào bắt Greig.",
  "Ngày ấy là 22 tháng 6 năm 2011.",
  "Ông tám mươi mốt tuổi.",
  "Chú thích bức ảnh tòa nhà nói ông đã sống ở đó ít nhất mười lăm năm với tư cách người chạy trốn.",
  "Mười sáu năm là thời gian ông mất tích.",
  "Mười lăm năm là câu nói về chính tòa nhà ấy.",
  {
   "t": "Bạn đừng cộng hai câu thành một.",
   "p": 1.0
  }
 ],
