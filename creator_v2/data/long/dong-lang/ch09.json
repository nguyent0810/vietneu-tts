{
 "title": "Mạng lưới mua đường",
 "lines": [
  {
   "t": "Danh sách người nhận quà đến từ các bản kể về sau.",
   "p": 0.8
  },
  "Không có biên bản nào của thời ấy ghi đủ danh sách này.",
  "Ta đọc nó như đọc một lời đồn có tên người.",
  {
   "t": "Nhưng ta vẫn đọc, vì lời đồn ấy cũng là một phần của vụ án.",
   "p": 1.0
  },
  "Người đầu tiên là Đới Lạp.",
  "Ông đứng đầu cơ quan tình báo của Tưởng Giới Thạch.",
  "Theo các bản kể, Tôn gửi cho ông thanh Cửu Long Bảo Kiếm.",
  "Kèm theo là lời nhờ chuyển lên cấp trên.",
  {
   "t": "Một thanh kiếm đi từ tay Tôn Điện Anh đến tay người của Tưởng Giới Thạch.",
   "p": 1.0
  },
  "Người thứ hai là Tống Mỹ Linh, phu nhân của Tưởng Giới Thạch.",
  "Theo các bản kể, món dành cho bà là viên Dạ Minh Châu.",
  "Câu chuyện này được kể nhiều.",
  "Nhưng nó vẫn là câu chuyện kể.",
  {
   "t": "Không có giấy tờ nào ghi bà nhận viên ngọc ấy.",
   "p": 1.0
  },
  "Người thứ ba là Tống Tử Văn, anh của Tống Mỹ Linh.",
  "Ông giữ ghế Bộ trưởng Tài chính.",
  "Các bản kể nói ông nhận cặp dưa hấu phỉ thúy.",
  {
   "t": "Có bản còn nói thêm một chiếc đĩa rồng.",
   "p": 1.0
  },
  "Người thứ tư là Hà Ứng Khâm.",
  "Ông là Bộ trưởng Quân chính.",
  "Ủy ban điều tra vụ án nằm dưới tay ông.",
  "Theo các bản kể, ông nhận một thanh kiếm thời Càn Long và 50 vạn đồng bạc.",
  {
   "t": "Nếu điều này đúng, người điều tra đã nhận tiền của người bị điều tra.",
   "p": 1.0
  },
  "Người thứ năm là Diêm Tích Sơn, ở Thái Nguyên.",
  "Theo các bản kể, ông nhận các pho tượng Phật vàng.",
  "Sau đó ông lên tiếng, và giọng ông nhẹ đi.",
  {
   "t": "Ông nói cần xem xét kỹ hơn.",
   "p": 1.0
  },
  "Với mỗi cái tên, có thể hỏi hai câu.",
  "Người ấy có thể làm gì để vụ án chậm lại?",
  "Và người ấy có nhận gì không?",
  "Câu đầu trả lời được bằng chức vụ.",
  {
   "t": "Câu sau thì không.",
   "p": 1.0
  },
  "Nếu cộng lại, ta có năm cái tên.",
  "Một người giữ tình báo.",
  "Một người ở bên cạnh Tưởng Giới Thạch.",
  "Một người giữ tài chính.",
  "Một người điều tra.",
  {
   "t": "Một người giữ một vùng phía bắc.",
   "p": 1.0
  },
  "Ta không chứng minh được từng khoản.",
  "Nhưng ta thấy một khuôn.",
  "Mỗi người nhận quà đều ở đúng chỗ có thể làm vụ án chậm lại.",
  "Họ không cần ra lệnh bỏ vụ án.",
  {
   "t": "Họ chỉ cần nói rằng vụ này phức tạp.",
   "p": 1.0
  },
  "Đó là điều đáng giữ lại từ danh sách này.",
  "Không phải chuyện ai nhận món gì.",
  "Mà là chuyện tấm lưới ấy được dệt từ những vị trí có thật.",
  "Tưởng Giới Thạch cần quân.",
  "Hà Ứng Khâm cầm ủy ban.",
  "Đới Lạp đứng cạnh Tưởng.",
  {
   "t": "Cả ba đều có thật.",
   "p": 1.0
  }
 ],
