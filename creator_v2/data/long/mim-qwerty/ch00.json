{
 "title": "Hàng phím kỳ lạ",
 "lines": [
  "Bạn hãy nhìn xuống bàn phím một chút.",
  {
   "t": "Hàng chữ đầu tiên, từ trái sang. Q, W, E, R, T, Y.",
   "p": 1.0
